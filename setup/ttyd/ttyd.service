[Unit]
Description=Tailnet Web Terminal
Documentation=https://github.com/tsl0922/ttyd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=debian
Group=debian
WorkingDirectory=/var/www/custom/projects/jehpok/repo

# macOS Terminal "Pro" theme — colors from Apple's Terminal.app Pro
# profile (Settings > Profiles > Pro). Font: Menlo 13pt (macOS
# Terminal default for Pro). Falls back to Monaco / Courier New on
# non-mac browsers.
ExecStart=/usr/local/bin/ttyd -W -i 172.22.0.1 -p 7681 \
  -t fontSize=13 \
  -t 'fontFamily=Menlo,Monaco,"Courier New",monospace' \
  -t 'theme={"background":"#1e1c1c","foreground":"#d4d4d4","cursor":"#d4d4d4","cursorAccent":"#1e1c1c","selectionBackground":"#1bc9c9","black":"#1e1c1c","red":"#c91b1b","green":"#1bc91b","yellow":"#c91b1b","blue":"#1b1bc9","magenta":"#c91bc9","cyan":"#1bc9c9","white":"#d4d4d4","brightBlack":"#6f6f6f","brightRed":"#ff6f6f","brightGreen":"#6fff6f","brightYellow":"#ffff6f","brightBlue":"#6f6fff","brightMagenta":"#ff6fff","brightCyan":"#6fffff","brightWhite":"#ffffff"}' \
  bash

Restart=always
RestartSec=3

# Hardening: ttyd serves a shell; only allowlist what it needs.
# NOTE: NoNewPrivileges is intentionally OFF — ttyd gives debian an
# interactive shell, and sudo needs setuid to elevate. With NNP the
# kernel ignores setuid bits, so sudo fails with
# "no new privileges flag is set". We rely on Tailscale membership
# (Caddy @not_tailnet) for access control instead.
ProtectSystem=strict
# Strict makes /usr, /boot, /efi AND /var read-only by default.
# Whitelist the paths the operator actually writes to from a ttyd
# session (the project tree, the bind-mount data dirs, Docker
# buildx dir, the Claude settings dir, the daily log, the Docker
# socket). Everything else stays read-only.
ReadWritePaths=/var/www/custom /var/www/custom/projects/jehpok /var/www/custom/projects/jehpok/cloud/html /var/www/custom/projects/jehpok/cloud/users /var/www/custom/projects/jehpok/certs /home/debian/.docker /home/debian/.claude /home/debian/.ssh /var/log /run/docker.sock
ProtectHome=read-only
PrivateTmp=true
# PrivateDevices is OFF — shell scripts need /dev/null, /dev/zero,
# /dev/tty, /dev/pts/* for interactive use. Tailscale + Caddy
# @not_tailnet is the real access control, not /dev isolation.
PrivateDevices=false
# Allow IPv4, IPv6, and Unix-domain sockets (docker.sock, dbus, etc.).
# Without this, the default is AF_UNIX only, which breaks DNS+HTTPS+git.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
# MemoryDenyWriteExecute is OFF — JIT'd runtimes (Node, Python,
# some Go binaries) mmap RWX; the protection blocks them outright.
# The hardening that matters here is the access-control layer
# (Tailscale + Caddy), not W^X against the operator's own shell.
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
