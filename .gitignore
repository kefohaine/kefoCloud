.DS_Store
__pycache__/
*.pyc
# Every service .env: `make render` writes the instance block into each one for
# compose substitution, and some carry secrets. Regenerated on every render, so
# never tracked — a blanket rule, not a per-service list that rots.
services/*/.env
# Runtime data dirs — canonical home is {{DATA_DIR}}/: the
# single external tree (containers, databases, uploads, installed-module
# reports). Everything untracked lives there; the repo tree stays clean.
/data/

# Defensive: never commit these even if a stray copy lands in the repo root.
/backups/
/caddy_data/
/cloud/
/download/
/eaglercraft/
/kuma/
/mailserver/
/pgdata/
/puffer/
/talk/
/vault/

# Secrets — never commit (goose reads this via EnvironmentFile=; live path is /etc/goose/goose.env)
config/goose/goose.env
