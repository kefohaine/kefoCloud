[Unit]
Description={{HOSTNAME}} stack — every deployed compose unit up on boot
Documentation=file://{{REPO_DIR}}/docs/GUIDE.md
After=docker.service network-online.target tailscaled.service remote-fs.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Idempotent: brings up every DEPLOYED compose unit, edge last. Never rebuilds
# and never recreates a healthy container — `docker compose up -d` is a no-op
# when nothing changed, so a boot costs no downtime and no image pull.
ExecStart={{REPO_DIR}}/scripts/stack-up.sh
ExecReload={{REPO_DIR}}/scripts/stack-up.sh
TimeoutStartSec=900

[Install]
WantedBy=multi-user.target
