[Unit]
Description=tmux 'main' session — one persistent shell session on every boot
Documentation=man:tmux(1)
Documentation=file:{{REPO_DIR}}/docs/GUIDE.md
After=network-online.target local-fs.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=HOME=/root
Environment=TERM=screen
# Creates the session only if it is missing (tmux is idempotent about an
# existing name — it errors, which is why the guard is in ExecStart).
ExecStart=/bin/sh -c 'if /usr/bin/tmux has-session -t main 2>/dev/null; then exit 0; fi; exec /usr/bin/tmux new-session -d -s main -n shell'
ExecStartPost=/bin/sh -c '/usr/bin/tmux set-option -t main -g history-limit 50000 2>/dev/null || true'
# DELIBERATELY no ExecStop: stopping/restarting this unit must never kill a
# session that shells (or the agent) are attached to. Sessions end at shutdown.
ExecReload=/bin/sh -c 'if /usr/bin/tmux has-session -t main 2>/dev/null; then exit 0; fi; exec /usr/bin/tmux new-session -d -s main -n shell'

[Install]
WantedBy=multi-user.target
