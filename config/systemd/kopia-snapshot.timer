[Unit]
Description=kopia: periodic snapshot into the repository on external backup storage

[Timer]
# One window a day, at midnight: the repository sits on external backup storage,
# so the run is placed where that machine is normally plugged in and idle. A
# missed window is visible as a failed unit rather than silently skipped.
OnCalendar=*-*-* 00:00:00
RandomizedDelaySec=10m
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
