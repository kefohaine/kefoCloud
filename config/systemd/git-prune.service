[Unit]
Description=git: drop local branches whose pull request landed
Documentation=file:{{REPO_DIR}}/scripts/ops/git-prune.sh
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart={{REPO_DIR}}/scripts/ops/git-prune.sh
# One fetch and a local ref delete — a window that outlives this is a wedged
# transport, and the script's own fetch budget already bounds the wait.
TimeoutStartSec=5min
Nice=10
IOSchedulingClass=idle
