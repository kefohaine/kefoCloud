[Unit]
Description=git: daily prune of local branches whose pull request landed

[Timer]
# `OnCalendar` at 04:17, not midnight: the kopia snapshot window owns 00:00 and
# both walk this host's disk. Persistent so a host that was off still prunes
# once when it comes back rather than skipping the day.
OnCalendar=*-*-* 04:17:00
RandomizedDelaySec=10m
Persistent=true
AccuracySec=1m

[Install]
WantedBy=timers.target
