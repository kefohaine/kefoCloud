{
  "_comment": "Project-level Claude Code safety rail. Copied to .claude/settings.local.json by 'make install-claude' / 'make install-config'. The 'allow' rule lets the operator's recurring docker / git / make / curl invocations run without prompts; the 'deny' rules stay so protected host resources (systemd, secrets, user-data) still require explicit operator approval.",
  "permissions": {
    "allow": [
      "Bash(*)"
    ],
    "deny": [
      "Bash(systemctl disable ollama)",
      "Bash(systemctl disable ttyd)",
      "Bash(systemctl disable dnsmasq)",
      "Bash(systemctl disable sshd)",
      "Bash(systemctl disable jehpok-daily.*)",
      "Bash(systemctl stop ollama)",
      "Bash(systemctl stop ttyd)",
      "Bash(systemctl stop dnsmasq)",
      "Bash(systemctl stop sshd)",
      "Bash(systemctl stop jehpok-daily.*)",
      "Bash(systemctl mask ollama)",
      "Bash(systemctl mask ttyd)",
      "Bash(systemctl mask dnsmasq)",
      "Bash(systemctl mask sshd)",
      "Bash(rm * /etc/systemd/system/ollama.service)",
      "Bash(rm * /etc/systemd/system/ttyd.service)",
      "Bash(rm * /etc/dnsmasq.d/10-tailnet.conf)",
      "Bash(rm * /etc/systemd/system/dnsmasq.service.d/*)",
      "Bash(rm * /var/www/custom/projects/jehpok/certs/*)",
      "Bash(rm * /var/www/custom/projects/jehpok/cloud/users/*)",
      "Bash(rm * /var/www/custom/projects/jehpok/cloud/html/*)",
      "Bash(rm * /var/www/custom/projects/jehpok/vault/*)",
      "Bash(rm * /var/www/custom/projects/jehpok/share/db/*)",
      "Bash(docker network rm net)",
      "Bash(docker network prune *)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)",
      "Bash(docker compose -f *share* down *)",
      "Bash(docker compose -f *cloud* down *)",
      "Bash(docker compose -f *vault* down *)",
      "Bash(docker exec cloud php occ *)",
      "Bash(docker exec share *)",
      "Bash(docker exec vault *)",
      "Bash(docker exec * sqlite3 *)",
      "Read(/var/www/custom/projects/jehpok/certs/**)",
      "Read(/var/www/custom/projects/jehpok/cloud/users/**)",
      "Read(/var/www/custom/projects/jehpok/vault/**)",
      "Read(/var/www/custom/projects/jehpok/share/db/**)"
    ]
  }
}
