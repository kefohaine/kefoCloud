{
  "_comment": "Project-level Claude Code safety rail. Copied to .claude/settings.local.json by 'make install-claude' / 'make install-config'. The 'allow' rule lets the operator's recurring docker / git / make / curl invocations run without prompts; the 'deny' rules stay so protected host resources (systemd, secrets, user-data) still require explicit operator approval.",
  "permissions": {
    "allow": [
      "Bash(*)"
    ],
    "deny": [
      "Bash(systemctl disable goose)",
      "Bash(systemctl disable ttyd)",
      "Bash(systemctl disable dnsmasq)",
      "Bash(systemctl disable sshd)",
      "Bash(systemctl disable homelab-daily.*)",
      "Bash(systemctl stop goose)",
      "Bash(systemctl stop ttyd)",
      "Bash(systemctl stop dnsmasq)",
      "Bash(systemctl stop sshd)",
      "Bash(systemctl stop homelab-daily.*)",
      "Bash(systemctl mask goose)",
      "Bash(systemctl mask ttyd)",
      "Bash(systemctl mask dnsmasq)",
      "Bash(systemctl mask sshd)",
      "Bash(rm * /etc/systemd/system/goose.service)",
      "Bash(rm * /etc/systemd/system/ttyd.service)",
      "Bash(rm * /etc/dnsmasq.d/10-tailnet.conf)",
      "Bash(rm * /etc/systemd/system/dnsmasq.service.d/*)",
      "Bash(rm * /var/www/custom/projects/homelab/certs/*)",
      "Bash(rm * /var/www/custom/projects/homelab/cloud/users/*)",
      "Bash(rm * /var/www/custom/projects/homelab/cloud/html/*)",
      "Bash(rm * /var/www/custom/projects/homelab/vault/*)",
      "Bash(rm * /var/www/custom/projects/homelab/share/db/*)",
      "Bash(docker network rm net)",
      "Bash(docker network prune *)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)",
      "Bash(docker compose -f *share-flask* down *)",
      "Bash(docker compose -f *nextcloud* down *)",
      "Bash(docker compose -f *vaultwarden* down *)",
      "Bash(docker exec nextcloud php occ *)",
      "Bash(docker exec share-flask *)",
      "Bash(docker exec vaultwarden *)",
      "Bash(docker exec * sqlite3 *)",
      "Read(/var/www/custom/projects/homelab/certs/**)",
      "Read(/var/www/custom/projects/homelab/cloud/users/**)",
      "Read(/var/www/custom/projects/homelab/vault/**)",
      "Read(/var/www/custom/projects/homelab/share/db/**)"
    ]
  }
}
