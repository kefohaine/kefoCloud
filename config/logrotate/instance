# /etc/logrotate.d/instance — installed by `make install-config` from
# config/logrotate/instance.
#
# Every log this project writes lives in {{LOG_DIR}} (wizard.log,
# uninstall.log, and any log an installed module writes). This single rule is
# what keeps that namespace bounded: 8 weeks, compressed, so the namespace can
# never grow without limit. Nothing else in the project logs per-event (no
# chronicle-style logging), and container output is capped at the daemon level
# (config/docker/daemon.json) — so these are the only files to rotate.
#
# The directory is created here too (`create` needs it to exist, and a fresh
# host runs logrotate before `make install-config` ever has).
{{LOG_DIR}}/*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    create 0640 root root
    su root root
}

# Caddy writes one access log per app here (bind-mounted into the container at
# /var/log/caddy). Caddy keeps the file open, so rotate with copytruncate rather
# than relying on a reopen signal that cannot reach the container.
{{LOG_DIR}}/caddy/*.log {
    weekly
    rotate 8
    compress
    delaycompress
    missingok
    notifempty
    copytruncate
    create 0640 root root
    su root root
}
