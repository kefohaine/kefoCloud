[Unit]
Description=Tailnet Web Terminal
Documentation=https://github.com/tsl0922/ttyd
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=op
Group=op
WorkingDirectory=/var/www/custom/projects/homelab/repo

# macOS Terminal "Pro" theme — colors from Apple's Terminal.app Pro
# profile (Settings > Profiles > Pro). Font: Menlo 13pt (macOS
# Terminal default for Pro). Falls back to Monaco / Courier New on
# non-mac browsers.
ExecStart=/usr/local/bin/ttyd -W -i 172.22.0.1 -p 7681 -b /ttyd \
  -t fontSize=13 \
  -t 'fontFamily=Menlo,Monaco,"Courier New",monospace' \
  -t 'theme={"background":"#1e1c1c","foreground":"#d4d4d4","cursor":"#d4d4d4","cursorAccent":"#1e1c1c","selectionBackground":"#1bc9c9","black":"#1e1c1c","red":"#c91b1b","green":"#1bc91b","yellow":"#c91b1b","blue":"#1b1bc9","magenta":"#c91bc9","cyan":"#1bc9c9","white":"#d4d4d4","brightBlack":"#6f6f6f","brightRed":"#ff6f6f","brightGreen":"#6fff6f","brightYellow":"#ffff6f","brightBlue":"#6f6fff","brightMagenta":"#ff6fff","brightCyan":"#6fffff","brightWhite":"#ffffff"}' \
  bash

Restart=always
RestartSec=3

# Hardening: minimal. The threat model is a single operator using
# ttyd over Tailscale to manage the host. Access control is at the
# network layer (Tailscale membership + Caddy @not_tailnet), not at
# the unit-sandbox layer. No filesystem, device, namespace, or
# address-family restrictions — the operator can write anywhere on
# the host without a permission hunt.

[Install]
WantedBy=multi-user.target
