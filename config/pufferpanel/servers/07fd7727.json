{
  "type": "minecraft-java",
  "id": "07fd7727",
  "display": "Minecraft: Java Edition (Browser 1.8.8)",
  "icon": "minecraft-java",
  "data": {
    "eula": {
      "type": "boolean",
      "value": true,
      "display": "EULA Agreement (true/false)",
      "desc": "Do you (or the server owner) agree to the <a href='https://account.mojang.com/documents/minecraft_eula'>Minecraft EULA?</a>",
      "required": true,
      "userEdit": true
    },
    "ip": {
      "type": "string",
      "value": "0.0.0.0",
      "display": "IP",
      "desc": "What IP to bind the server to",
      "required": true,
      "userEdit": false
    },
    "jvmArgs": {
      "type": "string",
      "value": "-Xms512M -XX:+UseG1GC -XX:+ParallelRefProcEnabled -XX:MaxGCPauseMillis=200 -XX:+UnlockExperimentalVMOptions -XX:+DisableExplicitGC -XX:G1NewSizePercent=30 -XX:G1MaxNewSizePercent=40 -XX:G1HeapRegionSize=8M -XX:G1ReservePercent=20 -XX:G1HeapWastePercent=5 -XX:G1MixedGCCountTarget=4 -XX:InitiatingHeapOccupancyPercent=15 -XX:G1MixedGCLiveThresholdPercent=90 -XX:G1RSetUpdatingPauseTimePercent=5 -XX:SurvivorRatio=32 -XX:+PerfDisableSharedMem -XX:MaxTenuringThreshold=1",
      "display": "JVM Arguments",
      "desc": "Extra JVM arguments to pass (no AlwaysPreTouch: the heap grows on demand so host idle RAM stays low; 512M floor, 2G cap)",
      "required": false,
      "userEdit": false
    },
    "memory": {
      "type": "integer",
      "value": 2048,
      "display": "Memory (MB)",
      "desc": "How much memory in MB to allocate to the Java Heap (2G: flawless 1.8.8 at view-distance 8 without overkill)",
      "required": true,
      "userEdit": false
    },
    "motd": {
      "type": "string",
      "value": "fxmq.net | Play in your browser: mc.fxmq.net/play",
      "display": "MOTD message of the day",
      "desc": "This is the message that is displayed in the server list of the client, below the name. The MOTD does support <a href='https://minecraft.wiki/w/Formatting_codes' target='_blank'>color and formatting codes</a>.",
      "required": true,
      "userEdit": true
    },
    "port": {
      "type": "integer",
      "value": 25565,
      "display": "Port",
      "desc": "What port to bind the server to (EaglerXServer multiplexes the browser websocket onto this same port)",
      "required": true,
      "userEdit": false
    },
    "version": {
      "type": "string",
      "value": "1.8.8",
      "display": "Version",
      "desc": "Version of Minecraft you wish to install. The browser client (EaglercraftX 1.8.8) and this server must match: 1.8.8",
      "required": true,
      "userEdit": true
    }
  },
  "groups": [
    {
      "display": "General",
      "description": "General settings for all servers",
      "variables": [
        "eula",
        "memory",
        "ip",
        "port",
        "motd",
        "version",
        "jvmArgs"
      ],
      "order": 1
    }
  ],
  "install": [
    {
      "if": "!file_exists(\"server.jar\")",
      "type": "download",
      "files": [
        "https://cdn.getbukkit.org/spigot/spigot-1.8.8.jar"
      ]
    },
    {
      "if": "!file_exists(\"plugins/EaglerXServer.jar\")",
      "type": "download",
      "files": [
        "https://github.com/lax1dude/eaglerxserver/releases/latest/download/EaglerXServer.jar"
      ],
      "target": "plugins/EaglerXServer.jar"
    },
    {
      "if": "!file_exists(\".nio-patched\")",
      "type": "command",
      "commands": [
        "python3 -c \"import zipfile,sys; zin=zipfile.ZipFile('server.jar'); zout=zipfile.ZipFile('server.jar.new','w',zipfile.ZIP_DEFLATED); [zout.writestr(i, zin.read(i)) for i in zin.namelist() if not (i.startswith('META-INF/native/') and i.endswith('.so'))]; zout.close(); zin.close()\" && mv server.jar.new server.jar && touch .nio-patched"
      ]
    },
    {
      "if": "!file_exists(\"eula.txt\")",
      "type": "writefile",
      "target": "eula.txt",
      "text": "eula=${eula}"
    },
    {
      "if": "!file_exists(\"server.properties\")",
      "type": "writefile",
      "target": "server.properties",
      "text": "online-mode=false\nserver-ip=${ip}\nserver-port=${port}\nview-distance=8\nmotd=${motd}\n"
    }
  ],
  "uninstall": null,
  "run": {
    "command": [
      {
        "command": "java -Xms512M -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar server.jar nogui",
        "if": "env != 'host'"
      },
      {
        "command": "java -Xms512M -Xmx${memory}M -Dterminal.jline=false -Dterminal.ansi=true -Dlog4j2.formatMsgNoLookups=true ${jvmArgs} -jar server.jar nogui",
        "if": "env == 'host'"
      }
    ],
    "stop": "stop",
    "stdin": {
      "type": "stdin"
    },
    "autostart": false,
    "autorecover": false,
    "autorestart": false
  },
  "environment": {
    "type": "docker",
    "bindings": {},
    "containerRoot": "",
    "image": "eclipse-temurin:17",
    "networkName": "host",
    "portBindings": [
      "0.0.0.0:25565:25565/tcp"
    ]
  },
  "supportedEnvironments": [
    {
      "type": "host"
    },
    {
      "type": "docker",
      "image": "eclipse-temurin:17",
      "portBindings": [
        "0.0.0.0:25565:25565/tcp"
      ]
    }
  ],
  "requirements": {},
  "stats": {
    "type": "jcmd"
  },
  "query": {
    "type": "minecraft"
  },
  "keepAlive": {
    "frequency": "",
    "command": ""
  }
}