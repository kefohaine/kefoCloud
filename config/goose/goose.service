[Unit]
Description=Goose agent service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory={{REPO_DIR}}
ExecStart=/usr/local/bin/goose serve
# Server secret + the token-policy environment live in the INSTANCE tree
# (root:root 0600) — never in a tracked file, and never in a repo directory that
# could be mistaken for config. Created by the installer; older installs kept it
# at /etc/goose/goose.env and `make install-config` migrates it here.
EnvironmentFile=-{{DATA_DIR}}/goose/.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
