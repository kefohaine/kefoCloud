[Unit]
Description=Goose agent service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=op
Group=op
WorkingDirectory=/var/www/custom/projects/homelab/repo
ExecStart=/usr/local/bin/goose serve
# Server secret lives OUTSIDE the repo (root:op 0640) — never in a tracked file.
# Created by scripts/install.sh; live path /etc/goose/goose.env.
EnvironmentFile=-/etc/goose/goose.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
