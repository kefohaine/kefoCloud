[Unit]
Description=Goose agent service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory={{REPO_DIR}}
ExecStart=/usr/local/bin/goose serve
# Server secret lives OUTSIDE the repo (root:root 0640) — never in a tracked file.
# Created by scripts/install.sh; live path /etc/goose/goose.env.
EnvironmentFile=-/etc/goose/goose.env
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
