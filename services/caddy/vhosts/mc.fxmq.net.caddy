# mc.fxmq.net — PufferPanel at /panel, browser Minecraft at /play.
#   /panel     PufferPanel web UI (172.22.0.8:8080), prefix-stripped; its
#              baked root routes (/api, /auth, SPA pages, /assets, /swagger)
#              are proxied by @panel_infra below.
#   /play      EaglercraftX 1.8.8 client (static, /eaglercraft bind-mount)
#   /play/server  browser-MC WebSocket -> EaglerXServer on the game port
#              (host-net server, 172.22.0.1:25565)
# TLS: Let's Encrypt DNS-01 via Cloudflare (see vhosts/cloud.fxmq.net.caddy).
# /register is 403 at the edge — public account creation is closed; accounts
# are admin-created in the panel. Unknown paths answer the usual ok stub.

https://mc.fxmq.net {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
	import compress
	request_body {
		max_size 100m
	}
	header {
		import security_headers
	}
	# Registration closed (403): UI route, prefix-stripped API route and the
	# root passthrough path are all covered.
	@register path /panel/register* /auth/register* /panel/auth/register*
	handle @register {
		respond 403
	}
	# PufferPanel sends max-age=60 on its JS/wasm chunks, so the browser
	# revalidates the whole SPA every minute. Hashed chunk names mean a
	# panel upgrade self-invalidates; 86400 kills the refetch churn and
	# lets Cloudflare edge-cache the assets (Vary so each encoding is cached).
	@panel_static path /js/* /wasm/* /css/* /img/* /fonts/* /assets/*
	header @panel_static Cache-Control "public, max-age=86400"
	header @panel_static Vary "Accept-Encoding"
	# PufferPanel — prefix stripped so the panel sees its canonical root
	# paths (/dashboard, /servers, /api/...). Two blocks: `path /panel`
	# matches only the exact path, so /panel/* is needed for subpaths.
	handle_path /panel {
		reverse_proxy 172.22.0.8:8080 {
			# strip the panel's own security headers (site-level set yields one value)
		header_down -X-Frame-Options
		header_down -X-Content-Type-Options
		header_down -Referrer-Policy
		}
	}
	handle_path /panel/* {
		reverse_proxy 172.22.0.8:8080 {
		header_down -X-Frame-Options
		header_down -X-Content-Type-Options
		header_down -Referrer-Policy
		}
	}
	# PufferPanel's baked-absolute root routes (no subpath support): the
	# SPA's history-mode pages, /api REST + websocket console, /auth web
	# login, Vite /assets, and /swagger API docs.
	@panel_infra path /api/* /auth* /js/* /wasm/* /css/* /img/* /fonts/* /assets/* /swagger* /home/* /nodes* /dashboard /self /servers* /settings /templates* /users* /favicon.png /manifest.json
	handle @panel_infra {
		reverse_proxy 172.22.0.8:8080 {
		header_down -X-Frame-Options
		header_down -X-Content-Type-Options
		header_down -Referrer-Policy
		}
	}
	# `/` points at the panel.
	@root path /
	handle @root {
		redir * /panel 308
	}
	# In-browser Minecraft: /play serves the client, /play/server is the
	# websocket. /play keeps its trailing slash — the client resolves assets
	# (classes.js, assets.epk) RELATIVE to the page URL, so serving index.html
	# at /play (no slash) breaks every asset path. 308 to /play/ keeps the
	# base URL on the dir.
	@play_root path /play
	redir @play_root /play/ 308
	# Eaglercraft clients connect to wss://mc.fxmq.net/play/server; the
	# websocket is multiplexed by EaglerXServer on the game server's own port
	# (host-net 172.22.0.1:25565, shared with the Java server — one runs at a
	# time). Must precede the /play/* static handler.
	handle_path /play/server {
		reverse_proxy 172.22.0.1:25565
	}
	handle_path /play/* {
		root * /eaglercraft
		file_server
	}
	# Catch-all: the usual ok stub.
	handle {
		respond "ok" 200
	}
}
