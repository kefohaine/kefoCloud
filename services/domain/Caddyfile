{
    admin off
    log {
        output file /dev/null
    }
}

# ── snippets ────────────────────────────────────────────────────────────────

(tls_keys) {
    tls /certs/cert.pem /certs/key.pem
}

(security_headers) {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
}

(serve_static) {
    encode zstd gzip
    header {
        import security_headers
    }
    request_body {
        max_size 100m
    }
    file_server
    handle_errors 404 {
        respond "not found"
    }
}

# ── HTTP → HTTPS ────────────────────────────────────────────────────────────

http:// {
    redir https://{host}{uri} 308
}

# ── static sites ────────────────────────────────────────────────────────────

https://www.jehpok.com {
    import tls_keys
    request_body {
        max_size 100m
    }
    header {
        import security_headers
    }
    reverse_proxy homer:8080
}

https://ops.jehpok.com {
    import tls_keys
    @not_tailnet not remote_ip 100.64.0.0/10
    respond @not_tailnet 403
    @share path /share /share/*
    handle @share {
        reverse_proxy share:5000
    }
    @terminal path /terminal /terminal/*
    handle @terminal {
        uri strip_prefix /terminal
        reverse_proxy 172.22.0.1:7681 {
            transport http {
                versions 1.1
            }
        }
    }
    handle {
        @root path /
        respond @root "ok"
        respond "not found" 404
    }
}

# ── URL shortener + file sharing ───────────────────────────────────────────

https://share.jehpok.com {
    import tls_keys
    request_body {
        max_size 100m
    }
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    @admin path /share /share/* /api /api/* /healthz
    respond @admin "not found" 404
    @browse path /files /files/*
    handle @browse {
        root * /files
        uri strip_prefix /files
        file_server browse {
            precompressed zstd gzip
        }
    }
    handle_errors 404 {
        respond "not found"
    }
    reverse_proxy share:5000 {
        @notfound status 404
        handle_response @notfound {
            respond "not found" 404
        }
    }
}

