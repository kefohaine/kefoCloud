}

# ── Nextcloud (PHP-FPM) ────────────────────────────────────────────────────

https://cloud.jehpok.com {
    import tls_keys
    root * /nextcloud
    request_body {
        max_size 100m
    }
    @blocked path /data/* /config/* /lib/* /3rdparty/* /templates/* /occ /console.php /db/* /updater/*
    respond @blocked "not found" 404
    redir /.well-known/carddav /remote.php/dav 301
    redir /.well-known/caldav /remote.php/dav 301
    php_fastcgi cloud:9000 {
        root /var/www/html
        dial_timeout 10s
        read_timeout 300s
        write_timeout 300s
    }
    encode zstd gzip
    header {
        import security_headers
    }
    file_server
}

