{
    admin off
}

(tls_keys) {
    tls /certs/cert.pem /certs/key.pem
}

(serve_static) {
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    file_server
}

# Redirect all plaintext HTTP to HTTPS.
http:// {
    redir https://{host}{uri} 308
}

https://www.jehpok.com {
    import tls_keys
    root * /srv/content/domain/www
    import serve_static
}

https://app.jehpok.com {
    import tls_keys
    root * /srv/content/domain/app
    import serve_static
}

https://vps.jehpok.com {
    import tls_keys

    # Tailscale-only: reject any client whose source IP is not on the
    # tailnet (100.64.0.0/10 CGNAT range). Defense-in-depth on top of
    # the DNS split — blocks anyone reaching the vhost via the public IP.
    @not_tailnet not remote_ip 100.64.0.0/10
    respond @not_tailnet 403

    @link path /link /link/*
    reverse_proxy @link link:5000

    root * /srv/content/domain/vps
    import serve_static
}

# Public URL shortener. Only slug routes (GET /<slug>) are proxied;
# admin UI, API, and healthz are Tailscale-only via vps.jehpok.com/link.
https://link.jehpok.com {
    import tls_keys
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }
    @admin path /link /link/* /api /api/* /healthz
    respond @admin "not found"

    reverse_proxy link:5000 {
        @notfound status 404
        handle_response @notfound {
            respond "not found"
        }
    }
}

# Public file workshop: directory browse over a static root.
# Drop files into content/domain/files/ and they are listed publicly.
https://files.jehpok.com {
    import tls_keys
    root * /srv/content/domain/files
    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    file_server browse {
        precompressed zstd gzip
    }
}

https://api.jehpok.com {
    import tls_keys
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
    }
    respond "ok"
}

# Nextcloud: standalone hostname served by the `cloud` container.
# Trusted domains must include cloud.jehpok.com (set in the cloud container's env).
https://cloud.jehpok.com {
    import tls_keys

    root * /nextcloud

    request_body {
        max_size 10G
    }

    # Never expose Nextcloud's data/config/internal files.
    @blocked path /data/* /config/* /lib/* /3rdparty/* /templates/* /occ /console.php /db/* /updater/*
    respond @blocked 404

    # Nextcloud's well-known endpoints
    redir /.well-known/carddav /remote.php/dav 301
    redir /.well-known/caldav /remote.php/dav 301

    php_fastcgi cloud:9000 {
        root /var/www/html
        dial_timeout 10s
        read_timeout 300s
        write_timeout 300s
    }

    encode zstd gzip
    header {
        Strict-Transport-Security "max-age=31536000"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    file_server
}