# www.homelab.com — static GitHub Pages mirror, cached origin pulls only.
# TLS: Let's Encrypt DNS-01 via Cloudflare (see vhosts/mc.homelab.com.caddy
# for why all vhosts use DNS-01 — wildcard cert conflict prevented
# per-vhost ACME automation policies from firing).

https://www.homelab.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    request_body {
        max_size 100m
    }
    header {
        import security_headers
    }
    reverse_proxy 172.22.0.2:8080
}
