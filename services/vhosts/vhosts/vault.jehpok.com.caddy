# vault.jehpok.com — Vaultwarden password manager.
# TLS: Let's Encrypt DNS-01 via Cloudflare (see vhosts/mc.jehpok.com.caddy).

https://vault.jehpok.com {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    request_body {
        max_size 100m
    }
    header {
        import security_headers
    }
    reverse_proxy 172.22.0.4:80
}
