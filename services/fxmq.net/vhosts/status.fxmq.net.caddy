# status.fxmq.net — Uptime Kuma status monitor.
# Renamed from kuma.fxmq.net (operator request, Aug 2026); the old
# hostname's DNS record and vhost were removed.
# TLS: Let's Encrypt DNS-01 via Cloudflare (see vhosts/cloud.fxmq.net.caddy).

https://status.fxmq.net {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    request_body {
        max_size 100m
    }
    header {
        import security_headers
    }
    reverse_proxy 172.22.0.6:3001
}
