# mail.fxmq.net — decommissioned stub: every path responds plain "ok".
# (Roundcube webmail retired from the edge 2026-08-28; the mail platform
# still runs on the bridge but is no longer routed. MX/SPF/DMARC/DKIM
# DNS records are unchanged.)
# TLS: Let's Encrypt DNS-01 via Cloudflare.

https://mail.fxmq.net {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    respond "ok" 200
}
