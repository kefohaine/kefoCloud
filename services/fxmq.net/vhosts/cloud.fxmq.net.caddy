# cloud.fxmq.net — decommissioned stub: every path responds plain "ok".
# (Nextcloud retired from the edge 2026-08-28; the container still runs on
# the bridge but is no longer routed.)
# TLS: Let's Encrypt DNS-01 via Cloudflare.

https://cloud.fxmq.net {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    respond "ok" 200
}
