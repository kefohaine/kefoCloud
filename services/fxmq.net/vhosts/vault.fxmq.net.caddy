# vault.fxmq.net — Vaultwarden password manager.
# TLS: Let's Encrypt DNS-01 via Cloudflare (see vhosts/cloud.fxmq.net.caddy).

https://vault.fxmq.net {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    request_body {
        max_size 100m
    }
    header {
        import security_headers
    }
    reverse_proxy 172.22.0.4:80 {
        # strip VW's own security headers so the site-level set yields one value
		header_down -X-Frame-Options
		header_down -X-Content-Type-Options
		header_down -Referrer-Policy
    }
}
