# mc.fxmq.net — decommissioned stub: every path responds plain "ok".
# (PufferPanel at /panel and the /download file browser retired from the
# edge 2026-08-28; the panel + game server still run on the bridge but are
# no longer routed — Minecraft lifecycle control via the panel is
# unavailable until the routes are restored.)
# TLS: Let's Encrypt DNS-01 via Cloudflare.

https://mc.fxmq.net {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    respond "ok" 200
}
