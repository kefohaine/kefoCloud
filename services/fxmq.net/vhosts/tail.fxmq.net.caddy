# tail.fxmq.net — tailnet entry point: the door list at / and the ttyd
# host shell at /ttyd.
#
# Access model:
#   * every path — non-tailnet sources get 403 (Tailscale membership required)
#   * /            — the door list (unauthenticated: any tailnet device can
#                    open it; it renders every webpage of the domain — public
#                    and tailnet-only — fetched live from /targets.json on
#                    every visit, no login, no session, no commands)
#   * /targets.json — GENERATED navigation catalogue (scripts/tail-targets.sh):
#                    the vhosts and their pages, so nothing is hardcoded
#   * /ttyd*      — the shell: HTTP basic auth (user `kefohaine`). Each visit
#                    prompts unless the browser holds a valid cached credential.
# `make tail-auth` sets/rotates the credential and prints it once (only the
# bcrypt hash is committed — never put the password in the repo).
#
# Caching: NOTHING on this vhost may be cached — not the door list, not the
# catalogue, not ttyd responses. `no-store` (forbids storing), the ETag /
# Last-Modified deletes (no validators left to revalidate against) and the
# legacy Pragma/Expires headers make every request hit the edge fresh.

https://tail.fxmq.net {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    header {
        import security_headers
        # Nothing here may be cached: a stale cached response would keep
        # serving a state the next request would not confirm.
        Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Pragma "no-cache"
        Expires "0"
        -ETag
        -Last-Modified
    }
    route {
        @not_tailnet not remote_ip 100.64.0.0/10
        respond @not_tailnet 403

        # Generated navigation catalogue for the terminal.
        handle /targets.json {
            root * /etc/caddy/www
            file_server
        }

        # ttyd host terminal — gated. Base path is /ttyd (ttyd -b /ttyd), so
        # the full path is proxied as-is — do not strip the prefix. The
        # terminal page authenticates against this with an explicit header,
        # never relying on the browser's cached credential.
        handle /ttyd* {
            basic_auth {
                kefohaine $2a$14$SbolWVoI8etI0M368qB.VujAdZg33b0IeUwzrXrAgKyiOpZfBOVoa
            }
            reverse_proxy 172.22.0.1:7681 {
                transport http {
                    versions 1.1
                }
            }
        }

        # The door list (static; services/$DOMAIN/www is mounted read-only
        # at /etc/caddy/www in the caddy container).
        handle / {
            root * /etc/caddy/www
            rewrite /tail.html
            file_server
        }

        # Everything else is the plain "ok" stub.
        handle {
            respond "ok" 200
        }
    }
}
