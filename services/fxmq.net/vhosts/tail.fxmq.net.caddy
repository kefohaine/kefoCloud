# tail.fxmq.net — tailnet-only entry point: a terminal-styled dashboard at /
# and the ttyd host shell at /ttyd.
#
# Access model, in order (the `route` block pins it):
#   1. every path — non-tailnet sources get 403 (Tailscale membership is required)
#   2. /ttyd only — HTTP basic auth (user `kefohaine`): membership is NOT
#      authorization for a full root-capable shell.
# The dashboard is deliberately unauthenticated (it is only a link list), so it
# can carry the log in / log out buttons; one basic-auth login is then
# remembered by the browser for the whole tail.fxmq.net origin.
# `make tail-auth` sets/rotates the credential and prints it once (only the
# bcrypt hash is committed — never put the password in the repo).

https://tail.fxmq.net {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    header {
        import security_headers
    }
    route {
        @not_tailnet not remote_ip 100.64.0.0/10
        respond @not_tailnet 403

        # ttyd host terminal — the gated path. Base path is /ttyd (ttyd -b
        # /ttyd), so the full path is proxied as-is — do not strip the prefix.
        handle /ttyd* {
            basic_auth {
                kefohaine $2a$14$SbolWVoI8etI0M368qB.VujAdZg33b0IeUwzrXrAgKyiOpZfBOVoa
            }
            reverse_proxy 172.22.0.1:7681 {
                transport http {
                    versions 1.1
                }
            }
        }

        # Terminal dashboard (static; services/$DOMAIN/www is mounted read-only
        # at /etc/caddy/www in the caddy container).
        handle / {
            root * /etc/caddy/www
            rewrite /tail.html
            file_server
        }

        # Everything else is the plain "ok" stub.
        handle {
            respond "ok" 200
        }
    }
}
