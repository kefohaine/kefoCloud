# tail.fxmq.net — tailnet entry point: a mini command terminal at / and the
# ttyd host shell at /ttyd.
#
# Access model:
#   * every path — non-tailnet sources get 403 (Tailscale membership required)
#   * /            — the terminal (unauthenticated: any tailnet device can open
#                    it; its `go` command refuses until `log in`)
#   * /targets.json — GENERATED navigation catalogue (scripts/tail-targets.sh):
#                    the vhosts and their pages, so nothing is hardcoded
#   * /ttyd*      — the shell: HTTP basic auth (user `kefohaine`). The
#                    terminal's `log in` navigates straight here, so the
#                    browser's basic-auth dialog is the login form; the
#                    credential the browser caches at this path scope is the
#                    session (later /ttyd visits need no re-prompt). `log out`
#                    overwrites the browser's cached credential with a bogus
#                    one via a primed fetch, so the next `log in` re-prompts.
#                    A 401 to a non-navigational fetch raises no dialog, so
#                    the page probes /ttyd to show the real session state.
# `make tail-auth` sets/rotates the credential and prints it once (only the
# bcrypt hash is committed — never put the password in the repo).

https://tail.fxmq.net {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    header {
        import security_headers
        # Nothing here may be cached: a stale cached response would keep
        # serving a state the next request would not confirm.
        Cache-Control "no-store"
    }
    route {
        @not_tailnet not remote_ip 100.64.0.0/10
        respond @not_tailnet 403

        # Generated navigation catalogue for the terminal.
        handle /targets.json {
            root * /etc/caddy/www
            file_server
        }

        # ttyd host terminal — gated. Base path is /ttyd (ttyd -b /ttyd), so
        # the full path is proxied as-is — do not strip the prefix.
        handle /ttyd* {
            basic_auth {
                kefohaine $2a$14$SbolWVoI8etI0M368qB.VujAdZg33b0IeUwzrXrAgKyiOpZfBOVoa
            }
            reverse_proxy 172.22.0.1:7681 {
                transport http {
                    versions 1.1
                }
            }
        }

        # The mini terminal (static; services/$DOMAIN/www is mounted read-only
        # at /etc/caddy/www in the caddy container).
        handle / {
            root * /etc/caddy/www
            rewrite /tail.html
            file_server
        }

        # Everything else is the plain "ok" stub.
        handle {
            respond "ok" 200
        }
    }
}
