# shell.fxmq.net — tailnet-only ttyd terminal. The root proxies straight
# to the host ttyd (172.22.0.1:7681). Non-tailnet sources get 403 on every
# path (Tailscale membership is the access control — see README "Domains
# and access model"). The /shell path was removed with operator approval.

https://shell.fxmq.net {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    @not_tailnet not remote_ip 100.64.0.0/10
    handle @not_tailnet {
        respond 403
    }
    handle {
        reverse_proxy 172.22.0.1:7681 {
            transport http {
                versions 1.1
            }
        }
    }
}
