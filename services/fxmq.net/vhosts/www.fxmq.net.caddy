# www.fxmq.net — static pages: the welcome pages and the public download drop
# folder.
#   /          serves ./www/index.html — a zero-second redirect to /welcome.
#   /welcome   the welcome page (welcome.html) — everything fxmq.net runs,
#              presented as the live demo of kefohaine/server.
#   /welcome-1 /welcome-2 /welcome-3 — alternate tellings of the same pitch,
#              each a different angle (proof / terminal / numbers).
#   /download* Caddy file_server browse over homelab/download (mounted at
#              /download:ro in the caddy container — drop files here).
#   everything else — plain "ok" stub.
# TLS: Let's Encrypt DNS-01 via Cloudflare (see vhosts/cloud.fxmq.net.caddy).

https://www.fxmq.net {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    header {
        import security_headers
    }
    handle_path /download {
        root * /download
        file_server browse
    }
    handle_path /download/* {
        root * /download
        file_server browse
    }
    # The welcome page — one self-contained HTML file. Matched with or
    # without a trailing slash; anything else keeps falling through to the
    # ok stub.
    @welcome path /welcome /welcome/
    handle @welcome {
        root * /etc/caddy/www
        rewrite /welcome.html
        file_server
    }
    # Alternate tellings: /welcome-1 (proof) /welcome-2 (terminal) /
    # /welcome-3 (numbers). Same self-contained-file pattern; the @wN
    # matchers + handle pairs below are also what the targets catalogue
    # generator reads, so the pages auto-appear in the tail door list.
    @w1 path /welcome-1 /welcome-1/
    handle @w1 {
        root * /etc/caddy/www
        rewrite /welcome-1.html
        file_server
    }
    @w2 path /welcome-2 /welcome-2/
    handle @w2 {
        root * /etc/caddy/www
        rewrite /welcome-2.html
        file_server
    }
    @w3 path /welcome-3 /welcome-3/
    handle @w3 {
        root * /etc/caddy/www
        rewrite /welcome-3.html
        file_server
    }
    # Homepage: the index.html placeholder (meta-redirects to /welcome).
    @home path /
    handle @home {
        root * /etc/caddy/www
        file_server
    }
    handle {
        respond "ok" 200
    }
}
