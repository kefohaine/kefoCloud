(tls_keys) {
    tls /certs/cert.pem /certs/key.pem
}

(serve_static) {
    encode zstd gzip
    file_server
}

https://www.jehpok.com {
    import tls_keys
    root * /srv/content/web/www
    import serve_static
}

https://app.jehpok.com {
    import tls_keys
    root * /srv/content/web/app
    import serve_static
}

https://vps.jehpok.com {
    import tls_keys
    root * /srv/content/web/vps
    import serve_static
}

https://api.jehpok.com {
    import tls_keys

    handle /ai* {
        reverse_proxy ai:8000
    }
    handle /status {
        reverse_proxy ai:8000
    }
}

# Nextcloud: standalone hostname served by the `cloud` container.
# Trusted domains must include cloud.jehpok.com (set in the cloud container's env).
https://cloud.jehpok.com {
    import tls_keys

    root * /nextcloud

    request_body {
        max_size 10G
    }

    # Never expose Nextcloud's data/config/internal files.
    @blocked path /data/* /config/* /lib/* /3rdparty/* /templates/* /occ /console.php
    respond @blocked 404

    # Nextcloud's well-known endpoints
    redir /.well-known/carddav /remote.php/dav 301
    redir /.well-known/caldav /remote.php/dav 301

    php_fastcgi cloud:9000

    file_server
}