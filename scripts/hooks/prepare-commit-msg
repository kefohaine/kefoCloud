#!/usr/bin/env bash
# prepare-commit-msg hook — AUTO-SPLIT a staged change that spans more than one
# unit into one commit per unit (AGENTS rule 26: one folder, at most one
# subfolder inside it; the units come from scripts/lib/commit-areas.sh).
# Installed via `make install-hooks`.
#
# Why THIS hook and not pre-commit: pre-commit runs BEFORE git composes the
# commit message, so a split there would re-use the PREVIOUS commit's message
# (a real trap — the stale message lands on every split piece). prepare-commit-msg
# is the earliest hook that has BOTH the staged index AND the message file, so
# the pieces get the message the operator actually typed.
#
# It runs scripts/info/git-split.sh --staged (which commits one commit per unit),
# then aborts the outer commit — the work is ALREADY committed, split.
# The abort is forced by git, not by us: `git commit` snapshots the HEAD it
# expects and errors `cannot lock ref 'HEAD': is at X but expected Y` if a hook
# moves HEAD under it, so no hook can split-and-succeed. Exiting 0 is not an
# option either (the index is then empty → "nothing to commit").
# It also APPENDS the `Revert:` recipe (rule 10) to any commit whose staged
# change touches more than SIGNIFICANT_FILE_THRESHOLD non-doc files — the one
# place that can see both the index and the message, so the SHA it names is the
# real parent. A docs-only change is never significant and gets no recipe.
#
# Args: $1 = the message file, $2 = source (message|template|merge|squash|commit).
# Skipped for merge/squash (a merge message is not a change message) and when
# ONE_CHANGE_OVERRIDE=1.

[ "${GIT_SPLIT_INTERNAL:-}" = 1 ] && exit 0   # a git-split replay: our own commits, stand down
repo=$(git rev-parse --show-toplevel)
. "$repo/scripts/lib/commit-areas.sh"
set -uo pipefail


case "${2:-}" in merge|squash) exit 0 ;; esac
[ "${ONE_CHANGE_OVERRIDE:-}" = "1" ] && exit 0
[ "${GIT_SPLIT_DISABLE:-}" = "1" ] && exit 0

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

# Rule 10 — append the recipe when the change is wide enough to need one.
append_revert() {
  local n
  n=$(printf '%s\n' "$staged" | while IFS= read -r p; do
        [ -n "$p" ] || continue
        commit_folder "$p" >/dev/null || continue
        printf '%s\n' "$p"
      done | grep -c . || true)
  [ "${n:-0}" -gt "$SIGNIFICANT_FILE_THRESHOLD" ] || return 0
  grep -qE '^[[:space:]]*Revert:' "$1" && return 0
  printf '\nRevert: git reset --hard %s\n' "$(git rev-parse HEAD)" >>"$1"
}

append_revert "$1"

units=$(printf '%s\n' "$staged" | commit_units)
nunits=$(printf '%s\n' "$units" | grep -c . || true)
[ "${nunits:-0}" -gt 1 ] || exit 0

splitter="$repo/scripts/info/git-split.sh"
[ -f "$splitter" ] || exit 0

echo "prepare-commit-msg: staged change spans $nunits units (rule 26: one folder, one subfolder) — splitting into one commit per unit:"
printf '  %s\n' $units
if GIT_SPLIT_MESSAGE_FILE="$1" bash "$splitter" --staged; then
  echo "prepare-commit-msg: done — the work is committed, in $nunits commits, each with"
  echo "  your message. Nothing to re-run; git reports this commit as aborted only"
  echo "  because it has nothing left to commit. (GIT_SPLIT_DISABLE=1 to only refuse.)"
  exit 1
fi
echo "prepare-commit-msg: auto-split failed — refusing the bundle."
exit 1
