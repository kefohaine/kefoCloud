#!/usr/bin/env bash
# pre-commit hook — guards the Caddy edge (installed via `make install-hooks`).
# Two guards:
#  1. If any file under modules/caddy/ is staged, the Caddyfile must
#     validate (via the running $DOMAIN container, when it's up).
#  2. A bare `respond "ok"` in an APP vhost (cloud/kuma/mail/vault) is
#     blocked — that is the stub that took every public subdomain offline on
#     2026-08-28. Operator-approved maintenance can pass with EDGE_OVERRIDE=1.
#     Exempt by design: www (health stub + /download) and tail (legit `ok`
#     paths). Any vhost another repo installs into the edge is guarded by
#     the pre-push smoke instead.

. "$(git rev-parse --show-toplevel)/scripts/lib/instance.sh" 2>/dev/null || true
set -uo pipefail

staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

# 0. Identity guard: a commit must never be authored as root. A fresh host has
#    no git identity, so git silently falls back to `root@<host>`, poisoning the
#    history with non-attributable commits (AGENTS rule 12). Fail loud and say
#    exactly how to fix it; install.sh writes the real identity at deploy time.
ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)
case "$ident" in
  *"root@"*|"root <"*)
    echo "pre-commit: refusing to commit as root — identity is '$ident'"
    echo "  Set the account-noreply identity first, e.g.:"
    echo "    git config user.name  <github-login>"
    echo "    git config user.email <account-id>+<github-login>@users.noreply.github.com"
    exit 1
    ;;
esac

# 1. Caddy config must validate when anything under modules/caddy/ changes.
if echo "$staged" | grep -q '^modules/caddy/'; then
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx 'caddy'; then
    if ! docker exec caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
      echo "pre-commit: Caddyfile invalid — refusing to commit."
      echo "  Diagnose: docker exec caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile"
      exit 1
    fi
  fi
fi

# 2. Stub guard on the app vhosts.
app_vhosts="cloud.caddy kuma.caddy mail.caddy vault.caddy"
for f in $app_vhosts; do
  if echo "$staged" | grep -q "^modules/caddy/vhosts/$f$"; then
    if git show :"modules/caddy/vhosts/$f" 2>/dev/null | grep -qE '^\s*respond "ok"'; then
      if [ "${EDGE_OVERRIDE:-}" != "1" ]; then
        echo "pre-commit: $f contains a bare \`respond \"ok\"\` stub."
        echo "  Stubbing an app vhost takes the service offline for every visitor."
        echo "  If this is an operator-approved change, commit with EDGE_OVERRIDE=1."
        exit 1
      fi
    fi
  fi
done

exit 0
