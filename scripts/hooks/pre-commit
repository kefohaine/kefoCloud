#!/usr/bin/env bash
# pre-commit hook — guards the Caddy edge and the commit identity (installed via
# `make install-hooks`). Guards:
#  0. The commit identity must be the operator's GitHub account (no root, no
#     invented address) — see below.
#  1. If any file under modules/caddy/ is staged, the Caddyfile must
#     validate (via the running $DOMAIN container, when it's up).
#  2. A bare `respond "ok"` in an APP vhost (cloud/kuma/mail/vault) is
#     blocked — that is the stub that took every public subdomain offline on
#     2026-08-28. Operator-approved maintenance can pass with EDGE_OVERRIDE=1.
#     Exempt by design: www (health stub + /download) and tail (legit `ok`
#     paths). Any vhost another repo installs into the edge is guarded by
#     the pre-push smoke instead.

[ "${GIT_SPLIT_INTERNAL:-}" = 1 ] && exit 0   # a git-split replay: our own commits, stand down
repo=$(git rev-parse --show-toplevel)
. "$repo/scripts/lib/instance.sh" 2>/dev/null || true
. "$repo/scripts/lib/commit-areas.sh"
set -uo pipefail


staged=$(git diff --cached --name-only)
[ -z "$staged" ] && exit 0

# 0. Identity guard: a commit must use the operator's logged-in GitHub identity,
#    never root and never an invented fallback. A fresh host has no git identity,
#    so git silently falls back to `root@<host>` (AGENTS rule 12) — and any other
#    non-GitHub address is not attributable either. Only a GitHub identity is
#    accepted: the account-noreply form git maps to the account
#    (`<id>+<login>@users.noreply.github.com`) or GitHub's own web-commit form
#    (`noreply@github.com`). Fail loud and say exactly how to fix it; the installer
#    writes the real identity (and user.useConfigOnly) at deploy time.
ident=$(git var GIT_AUTHOR_IDENT 2>/dev/null || true)
email=$(printf '%s' "$ident" | sed -n 's/^.*<\(.*\)>.*$/\1/p')
case "$email" in
  *@users.noreply.github.com|noreply@github.com) ;;
  *)
    echo "pre-commit: refusing to commit — identity '$ident' is not a GitHub identity."
    echo "  Commits must use the logged-in GitHub account (no root, no invented creds):"
    echo "    git config user.name  <github-login>"
    echo "    git config user.email <account-id>+<github-login>@users.noreply.github.com"
    exit 1
    ;;
esac

# 1. Caddy config must validate when anything under modules/caddy/ changes.
if echo "$staged" | grep -q '^modules/caddy/'; then
  if docker ps --format '{{.Names}}' 2>/dev/null | grep -qx 'caddy'; then
    if ! docker exec caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile >/dev/null 2>&1; then
      echo "pre-commit: Caddyfile invalid — refusing to commit."
      echo "  Diagnose: docker exec caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile"
      exit 1
    fi
  fi
fi

# 2. Stub guard on the app vhosts.
app_vhosts="cloud.caddy kuma.caddy mail.caddy vault.caddy"
for f in $app_vhosts; do
  if echo "$staged" | grep -q "^modules/caddy/vhosts/$f$"; then
    if git show :"modules/caddy/vhosts/$f" 2>/dev/null | grep -qE '^\s*respond "ok"'; then
      if [ "${EDGE_OVERRIDE:-}" != "1" ]; then
        echo "pre-commit: $f contains a bare \`respond \"ok\"\` stub."
        echo "  Stubbing an app vhost takes the service offline for every visitor."
        echo "  If this is an operator-approved change, commit with EDGE_OVERRIDE=1."
        exit 1
      fi
    fi
  fi
done

# 3. One change per commit (AGENTS rule 26) — AUTOMATED. The unit is the AREA
#    (scripts/lib/commit-areas.sh: `topdir/subdir`; docs ride with a change).
#    A multi-area staged change is committed as one commit per area by the
#    prepare-commit-msg hook, which runs right AFTER this one — pre-commit
#    cannot do it: it runs BEFORE the commit message exists, so the split would
#    carry a stale message. Here the hook only gates the case where splitting is
#    disabled: with GIT_SPLIT_DISABLE=1 (and no ONE_CHANGE_OVERRIDE) a bundle is
#    refused outright. With splitting enabled, this hook lets the bundle pass to
#    prepare-commit-msg, which splits it.
if [ "${ONE_CHANGE_OVERRIDE:-}" != "1" ] && [ "${GIT_SPLIT_DISABLE:-}" = "1" ]; then
  units=$(printf '%s\n' "$staged" | while IFS= read -r p; do commit_area "$p" || true; done \
            | grep -v '^$' | sort -u)
  nunits=$(printf '%s\n' "$units" | grep -c . || true)
  if [ "${nunits:-0}" -gt 1 ]; then
    echo "pre-commit: refusing to commit — this commit spans $nunits unrelated areas:"
    printf '  %s\n' $units
    echo "  One change per commit (AGENTS rule 26): split it with 'git add -p',"
    echo "  or unset GIT_SPLIT_DISABLE and let prepare-commit-msg split it."
    exit 1
  fi
fi

exit 0
