#!/usr/bin/env bash
# pre-push hook — runs the live vhost smoke test before every push, and
# warns when a push replaces remote history (installed via `make
# install-hooks`). Blocks pushing while the edge is broken (apps answering
# "ok" text/plain, dead SMTP/IMAP, etc.). This is the last line of defence
# against committing a stub deployment: the 2026-08-28 incident shipped an
# edge-wide change whose failure mode this test catches.
#
# There is NO bypass: smoke itself refuses to run unless wizard.state records
# finished=true, and this hook never writes state (the installer is its sole
# writer). A host without a finished install therefore cannot push — accepted.
#
# It also refuses a branch that would land as an empty merge or arrive
# CONFLICTING at a renamed path (scripts/info/pr-guard.sh), and refuses to run
# at all when the installed hooks are stale copies of the tracked ones.
#
# MAIN IS UNREACHABLE. This hook refuses any push whose destination is
# refs/heads/main (or master), and any non-branch ref at all: every change
# lands on a `temp-<N>` branch and reaches main only through a human-reviewed
# pull request on GitHub (AGENTS rule 30). The check runs BEFORE the smoke
# gate, so the refusal is unconditional — a broken edge must never mask, or be
# blamed for, a main push.
[ "${GIT_SPLIT_INTERNAL:-}" = 1 ] && exit 0   # a git-split replay: our own commits, stand down
set -uo pipefail


repo=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
# The commit-size limit (rule 26) lives in one place; the splitter it quotes
# reads the same file.
. "$repo/scripts/lib/commit-areas.sh" 2>/dev/null || true
COMMIT_MAX_FILES="${COMMIT_MAX_FILES:-10}"

# A hook copied by `make install-hooks` runs the WORKTREE's libraries, so once a
# commit reshapes one the installed copy calls what no longer exists and fails
# with the function's name instead of the cause (lesson 2026-11-05).
. "$repo/scripts/lib/hooks-fresh.sh" 2>/dev/null || true
if command -v hooks_fresh >/dev/null 2>&1 && ! hooks_fresh "$repo"; then
  echo "pre-push: REFUSED — the installed hooks are stale."
  exit 1
fi

# The ref list arrives on STDIN — read it before anything else can eat it. The
# smoke test below runs `openssl s_client`, which drains whatever is on stdin
# (it forwards it to the connection), and git feeds a hook a PIPE: once drained
# the guards below never see a ref, the loop body never runs, and the hook exits
# 0 having checked nothing. Grep-able symptom: a push that publishes a bundle
# or a non-GitHub identity and no pre-push line printed at all.
refs=$(cat)

# Main is write-once. A push is allowed only to a branch of this repo, never to
# refs/heads/main: `make git-start` creates the temp branch, `make git-pr`
# pushes it and prints the compare URL, and a human merges it. Tags are refused
# too (a pushed pre-rewrite tag re-exposes scrubbed identities on GitHub).
while read -r _lref _lsha rref _rsha; do
  [ -n "${rref:-}" ] || continue
  case "$rref" in
    refs/heads/main|refs/heads/master)
      echo "pre-push: REFUSED — $rref cannot be updated: main only changes through a reviewed pull request."
      echo "  Work on a temp-<N> branch: make git-start, then make git-com MSG=\"<what you are doing>\" … make git-pr"
      exit 1 ;;
    refs/heads/*) ;;
    *)
      echo "pre-push: REFUSED — only branch pushes are allowed (destination was $rref)."
      echo "  Every change lands on a temp-<N> branch and reaches main via a reviewed pull request."
      exit 1 ;;
  esac
done <<< "$refs"

# Pull-request shape (scripts/info/pr-guard.sh), checked before the smoke scan:
# a branch whose tree equals the base lands as an empty merge, and one that
# renames a path the base changed arrives CONFLICTING with the base's work left
# behind (lesson 2026-11-05). Cheap, read-only, and it names the file.
if [ -f "$repo/scripts/info/pr-guard.sh" ] && git -C "$repo" rev-parse --verify -q origin/main >/dev/null 2>&1; then
  while read -r _lref lsha rref _rsha; do
    case "$rref" in refs/heads/*) ;; *) continue ;; esac
    [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue
    if ! out=$(bash "$repo/scripts/info/pr-guard.sh" "origin/main..$lsha" 2>&1); then
      echo "pre-push: REFUSED — $rref is not submittable as it stands:"
      printf '%s\n' "$out" | sed 's/^/  /'
      echo "  Fix it (rebase onto origin/main, or carry the base's version of the renamed file)."
      echo "  OPERATOR ESCAPE: PR_GUARD_OVERRIDE=1 — report only, never a way to merge a branch that lands nothing."
      exit 1
    fi
  done <<< "$refs"
fi

smoke="$repo/scripts/stack/smoke-vhosts.sh"
[ -x "$smoke" ] || [ -f "$smoke" ] || exit 0

if ! bash "$smoke" </dev/null >/dev/null 2>&1; then
  echo "pre-push: vhost smoke test FAILED — the live edge is not serving the apps."
  echo "  Fix the running system first, then push again."
  echo "  (bash $smoke  — full output. No bypass: smoke runs only on a finished install.)"
  exit 1
fi

# History-rewrite guard. A normal push is a fast-forward: the remote tip is an
# ancestor of what we're pushing. If it isn't, this push replaces remote
# history (force-pushed rewrite) — which can leave GitHub's web git-data
# index 404/500 while git stays healthy (the 2026-09-03 incident; fixed by a
# nudge commit). Warn only — rewrites are legitimate, but the operator must
# verify with `make gh-web-health` once the push lands.
while read -r lref lsha rref rsha; do
  [ "$lsha" = "0000000000000000000000000000000000000000" ] && continue  # deletion
  [ "$lsha" = "$rsha" ] && continue                                   # nothing new
  # Identity guard: refuse to push any commit whose author/committer is not a
  # GitHub identity. Root (`root@<host>`, the no-identity fallback) and any
  # invented/non-GitHub address are non-attributable and must never reach the
  # remote (AGENTS rule 27); the installer sets the real identity at deploy time.
  # Runs before the fast-forward test so a NEW branch is scanned whole (rsha=0s).
  range="$lsha"; [ "$rsha" != "0000000000000000000000000000000000000000" ] && range="$rsha..$lsha"
  bad=$(git log --format='%ae%n%ce' "$range" 2>/dev/null \
        | grep -vE '(@users\.noreply\.github\.com|noreply@github\.com)$' | sort -u)
  if [ -n "$bad" ]; then
    echo "pre-push: refusing to push — the range $range has non-GitHub identities:"
    printf '  %s\n' $bad
    echo "  Fix the identity (git config user.name/user.email) and rewrite those commits, then push again."
    echo "  Inspect: git log --format='%h %ae %ce' $range"
    exit 1
  fi
  [ "$rsha" = "0000000000000000000000000000000000000000" ] && continue  # new branch: no rewrite warning

  # Commit hygiene over the pushed range (AGENTS rule 26: at most
  # COMMIT_MAX_FILES files per commit) — AUTOMATED. This is the only place a bad
  # commit can be caught when it did NOT come from this checkout: a
  # GitHub-web-editor commit runs no local hook at all. When the range breaks
  # the rule the hook runs scripts/info/git-split.sh (replay/rebase —
  # auto-split into chunks), then aborts so the operator re-runs `git push` on
  # the rewrapped history. git-split itself refuses to touch published commits,
  # so only local commits are ever rewritten.
  # Set GIT_SPLIT_DISABLE=1 to only refuse. Operator override: HISTORY_AUDIT_OVERRIDE=1.
  #
  # The audited range is NOT `$range` above: it holds only what this push
  # publishes — the commits reachable from the tip and from no remote ref. A
  # new branch (rsha = 0s) has no old tip, so `$range` is the whole history; and
  # after a rebase onto a newer base the old tip is not the base, so the base's
  # own commits land in it. Either way a published squash-merge commit on `main`
  # (one commit per pull request, far wider than the limit) fails an audit that
  # no push can fix — git-split refuses published history, so the push could
  # never complete. `<boundary>..<tip>` keeps git-audit's and git-split's
  # `<base>..<head>` contract; several boundary parents (a merge) fall back to
  # the old range.
  hyg_range="$range"
  boundary=$(git rev-list "$lsha" --not --remotes=origin --boundary 2>/dev/null | sed -n 's/^-//p')
  if [ -z "$boundary" ]; then
    hyg_range="$lsha"
  elif [ "$(printf '%s\n' "$boundary" | grep -c .)" = 1 ]; then
    hyg_range="$boundary..$lsha"
  fi
  if [ "${HISTORY_AUDIT_OVERRIDE:-}" != "1" ] && [ -f "$repo/scripts/info/git-audit.sh" ]; then
    if ! bash "$repo/scripts/info/git-audit.sh" "$hyg_range" >/dev/null 2>&1; then
      echo "pre-push: $hyg_range breaks the commit-hygiene rule (max $COMMIT_MAX_FILES files) — auto-splitting."
      if [ "${GIT_SPLIT_DISABLE:-}" != "1" ] && [ -f "$repo/scripts/info/git-split.sh" ] \
         && bash "$repo/scripts/info/git-split.sh" "$hyg_range"; then
        echo "pre-push: history rewritten — re-run 'git push' to publish the split commits."
        exit 1
      fi
      bash "$repo/scripts/info/git-audit.sh" "$hyg_range" | sed 's/^/  /'
      echo "  split manually (make git-audit RANGE=$hyg_range) or push with HISTORY_AUDIT_OVERRIDE=1."
      exit 1
    fi
  fi

  # Comments and user-facing strings describe the current configuration only
  # (AGENTS rule 31). Whole tree, read-only; override: PROSE_AUDIT_OVERRIDE=1.
  if [ -f "$repo/scripts/info/prose-audit.sh" ] \
     && ! bash "$repo/scripts/info/prose-audit.sh" >/dev/null 2>&1; then
    echo "pre-push: REFUSED — the tree breaks the prose rules (AGENTS rule 31)."
    bash "$repo/scripts/info/prose-audit.sh" | sed 's/^/  /'
    echo "  fix the findings above (make prose-audit) or push with PROSE_AUDIT_OVERRIDE=1."
    exit 1
  fi

  # Remote-landed commits (GitHub web editor, another host) ran no local hook,
  # so the pushed range above never sees them. Audit whatever the remote has
  # that this checkout does not (`$lsha..$rsha`) and REPORT it: those commits
  # are published, so git-split refuses them (rule 17) — a fix is an explicit
  # rewrite decision, never something this hook may do on its own.
  remote_only="$lsha..$rsha"
  if [ -n "$(git rev-list "$remote_only" 2>/dev/null | head -1)" ] \
     && [ -f "$repo/scripts/info/git-audit.sh" ]; then
    if ! bash "$repo/scripts/info/git-audit.sh" "$remote_only" >/dev/null 2>&1; then
      echo "pre-push: WARNING — published commits on the remote also break the commit-hygiene rule:"
      bash "$repo/scripts/info/git-audit.sh" "$remote_only" | sed 's/^/  /'
      echo "  They are already published: git-split refuses them (rule 17), so rewriting needs an explicit decision."
    fi
  fi

  if ! git merge-base --is-ancestor "$rsha" "$lsha" 2>/dev/null; then
    echo "pre-push: WARNING — this push replaces existing remote history (not a fast-forward)."
    echo "  After it lands, github.com may 404/500 while git stays healthy (2026-09-03 lesson)."
    echo "  Verify with: make gh-web-health   (remedy if red: a real, meaningful commit — e.g. docs-only — re-triggers the rebuild; never an empty one, AGENTS rule 27)"
  fi
done <<< "$refs"

exit 0
