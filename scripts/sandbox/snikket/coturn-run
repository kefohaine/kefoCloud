#!/bin/sh -e
# coturn run script for the Snikket sandbox module, bind-mounted read-only over
# /etc/sv/coturn/run. Tracked here so the fix survives a removed/rebuilt module;
# `make sbx-snikket-turn` installs it and proves TURNS answers.
#
# Why it exists: snikket-certs runs `prosodyctl cert import` hourly, which
# rewrites /etc/prosody/certs/<domain>.{crt,key} as prosody:prosody 0640/0400.
# coturn runs as the unprivileged `turnserver` user, so TURNS only started when
# this script's chown landed AFTER that import — a coin flip on every restart
# (5349 silently missing, `WARNING: cannot find certificate file`, calls over
# restrictive networks failing). Stage a copy the importer never touches and
# re-stage it when the source pair changes, instead of racing it.

if [ "$SNIKKET_TWEAK_TURNSERVER" = "0" ]; then
	echo "TURN server disabled by environment, not launching."
	exit 0
fi

DOMAIN="$SNIKKET_DOMAIN_ASCII"
SRC_CRT="/etc/prosody/certs/$DOMAIN.crt"
SRC_KEY="/etc/prosody/certs/$DOMAIN.key"
TLS_DIR="/snikket/prosody/tls"
CRT="$TLS_DIR/coturn.crt"
KEY="$TLS_DIR/coturn.key"
STAMP="$TLS_DIR/coturn.src"
LOCK="$TLS_DIR/coturn-watch.pid"

echo "Waiting for certificates to become available..."
while ! { test -f "$SRC_CRT" && test -f "$SRC_KEY"; }; do
	sleep 1
	echo "."
done

install -d -o turnserver -g turnserver -m 750 "$TLS_DIR"

# stage_certs — copy the pair into a turnserver-owned dir, retrying while an
# import is midway through replacing the sources, and verify both halves parse
# before coturn is allowed to use them.
stage_certs() {
	local i
	for i in 1 2 3 4 5; do
		if install -o turnserver -g turnserver -m 640 "$SRC_CRT" "$CRT" 2>/dev/null &&
			install -o turnserver -g turnserver -m 600 "$SRC_KEY" "$KEY" 2>/dev/null &&
			openssl x509 -in "$CRT" -noout >/dev/null 2>&1 &&
			openssl pkey -in "$KEY" -noout >/dev/null 2>&1; then
			return 0
		fi
		sleep 1
	done
	return 1
}

if ! stage_certs; then
	echo "coturn: WARNING: no valid certificate pair under /etc/prosody/certs — starting WITHOUT a TLS listener (TURNS down)"
fi
sha256sum "$SRC_CRT" "$SRC_KEY" >"$STAMP" 2>/dev/null || true

if ! test -f /snikket/prosody/turndb; then
	touch /snikket/prosody/turndb
fi
chown turnserver:turnserver /snikket/prosody/turndb
chmod 600 /snikket/prosody/turndb

# Renewal: coturn reads its certificate only at startup, so a renewed pair is
# re-staged and the service restarted. One watcher at a time (the pid file is
# inherited across the s6 restart the watcher itself triggers).
watch_certs() {
	while sleep 300; do
		if [ "$(sha256sum "$SRC_CRT" "$SRC_KEY" 2>/dev/null)" = "$(cat "$STAMP" 2>/dev/null)" ]; then
			continue
		fi
		stage_certs || continue
		sha256sum "$SRC_CRT" "$SRC_KEY" >"$STAMP" 2>/dev/null || true
		echo "coturn: certificate pair changed — restarting TURNS"
		s6-svc -r /etc/sv/coturn
		exit 0
	done
}

if ! { test -s "$LOCK" && kill -0 "$(cat "$LOCK" 2>/dev/null)" 2>/dev/null; }; then
	watch_certs &
	echo $! >"$LOCK"
fi

TURN_EXTERNAL_IP="$(snikket-turn-addresses "$DOMAIN")"

min_port="${SNIKKET_TWEAK_TURNSERVER_MIN_PORT:-49152}"
max_port="${SNIKKET_TWEAK_TURNSERVER_MAX_PORT:-65535}"

exec s6-setuidgid turnserver /usr/bin/turnserver -c /etc/turnserver.conf --prod \
	--static-auth-secret="$(cat /snikket/prosody/turn-auth-secret-v2)" \
	--cert="$CRT" --pkey "$KEY" -r "$DOMAIN" \
	--min-port "$min_port" --max-port "$max_port" \
	--listening-port "${SNIKKET_TWEAK_TURNSERVER_PORT-3478}" \
	--pidfile /snikket/prosody/turnserver.pid \
	-X "$TURN_EXTERNAL_IP"
