# Top-level Caddy config. Per-vhost routes live in ./vhosts/*.caddy
# and are imported below. Each PUBLIC vhost declares its own TLS block —
# DNS-01 via the Cloudflare plugin (token in CF_API_TOKEN env var) with a
# FALLBACK CHAIN of free ACME issuers: Let's Encrypt -> Buypass Go SSL ->
# ZeroSSL. If one issuer rate-limits an identifier (e.g. LE's
# 5 orders/name/week), Caddy automatically tries the next issuer, so no
# vhost is ever left without a cert because of a rate limit.
# The old CF Origin CA wildcard cert was
# removed because its SNI wildcard (`*.{{DOMAIN}}`) covered every
# vhost and the per-vhost ACME automation policy never fired.
# Per-vhost LE certs keep each cert scoped to its own SNI.

{
    admin off
    log {
        # Default logger to stderr: the compose log cap bounds it, and an
        # edge/ACME failure leaves real evidence in `docker logs caddy`.
        output stderr
    }
}

# ── snippets ────────────────────────────────────────────────────────────────

# Security headers. NOTE: Caddy's header directive APPENDS to upstream values
# (set does not replace) and a delete+set pair for the SAME field in one block
# ends up deleted (delete wins) — so app vhosts strip the upstream's own copies
# with `header_down` at the proxy (cloud/vault/kuma/roundcube/ttyd/hpb)
# and this snippet only ever SETS. Never add `-<Field>` delete lines here.
(security_headers) {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "SAMEORIGIN"
    Referrer-Policy "strict-origin-when-cross-origin"
}

# Compress every response that has a compressible MIME type (default 512 B
# threshold, text/* + JSON + SVG + JS + CSS + XML). Caddy's `encode`
# middleware can't live in the global options block — it has to be inside
# each site block or imported via a snippet. Every vhost below either sets
# `encode zstd gzip` explicitly or imports this snippet, so no response
# leaks uncompressed.
(compress) {
    encode zstd gzip
}

# ── HTTP → HTTPS ────────────────────────────────────────────────────────────
http:// {
    redir https://{host}{uri} 308
}

# ── vhosts ──────────────────────────────────────────────────────────────────
# Each public vhost declares its own `tls { dns cloudflare { ... } }` block so
# the ACME cert is scoped to that vhost's SNI (tail.{{DOMAIN}} included), so
# no cert is shared across SNI names (see ./vhosts/cloud.caddy for the rationale).

# A glob, deliberately: a glob that matches nothing is NOT an error in
# Caddy, so vhosts/ can be empty and the edge still starts. That is what
# makes the edge extensible — another project drops in
# vhosts/<name>.caddy and the site exists, no edit to this repo required.
# Adding a file needs a CONTAINER RESTART (the edge runs `admin off`, so
# `caddy reload` has no admin API to talk to).
import vhosts/*.caddy
