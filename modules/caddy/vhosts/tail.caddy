# tail.{{DOMAIN}} — tailnet entry point: the tailnet door list at / and the
# ttyd host shell at /ttyd.
#
# Access model — Tailscale MEMBERSHIP is the only gate, by operator choice:
#   * every path — non-tailnet sources get 403 (@not_tailnet)
#   * /            — the tailnet door list: every TAILNET-only route of this
#                    domain (the shell) fetched live from /targets.json on
#                    every visit. No login, no session, no commands.
#   * /targets.json — GENERATED catalogue (scripts/access/tail-targets.sh)
#   * /ttyd*      — the shell. Deliberately UNAUTHENTICATED: a tailnet device
#                    that can reach the vhost gets a root shell, no second
#                    credential (HTTP basic auth was removed 2026-09-22 by
#                    operator request — membership IS the auth). Reaching it
#                    non-tailnet is impossible: the 403 above runs first.
#
# Caching: NOTHING on this vhost may be cached — not the door list, not the
# catalogue, not ttyd responses. `no-store` (forbids storing), the ETag /
# Last-Modified deletes (no validators left to revalidate against) and the
# legacy Pragma/Expires headers make every request hit the edge fresh.
#
# TLS — Let's Encrypt DNS-01 via Cloudflare, same as every public vhost: the
# operator asked for a trusted cert on the door too (no self-signed warning).
# The name must resolve publicly for browsers to reach it by that name; if the
# LE order cannot complete (e.g. the per-identifier rate limit), the installer
# does NOT fail — it lists scripts/ops/tailscale-https.sh as a follow-up, which
# exposes the door over Tailscale HTTPS instead (a different web address:
# https://<machine>.<tailnet>.ts.net).
https://tail.{{DOMAIN}} {
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    header {
        import security_headers
        # Nothing here may be cached: a stale cached response would keep
        # serving a state the next request would not confirm.
        Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Pragma "no-cache"
        Expires "0"
        -ETag
        -Last-Modified
    }
    route {
        @not_tailnet not remote_ip 100.64.0.0/10
        respond @not_tailnet 403

        # Generated navigation catalogue for the terminal.
        handle /targets.json {
            root * /srv/pages/tail
            file_server
        }

        # Beszel hub — the SPA is served under /beszel because the hub's
        # APP_URL carries that path: the HTML it emits points at
        # /beszel/assets/... and /beszel/static/..., while the hub itself only
        # serves /assets and /static. Strip the prefix (the hub's router
        # tolerates either form) so both the page and its assets resolve.
        @beszel_root path /beszel
        redir @beszel_root /beszel/ 308
        handle_path /beszel/* {
            reverse_proxy 172.22.0.13:8090
        }

        # ttyd host terminal — no second credential (see the header). Base
        # path is /ttyd (ttyd -b /ttyd), so the full path is proxied as-is —
        # do not strip the prefix.
        handle /ttyd* {
            reverse_proxy 127.0.0.1:7681 {
                transport http {
                    versions 1.1
                }
            }
        }

        # The door list (static; $DATA_DIR/pages/tail is mounted read-only
        # at /srv/pages/tail in the caddy container).
        handle / {
            root * /srv/pages/tail
            rewrite /tail.html
            file_server
        }

        # Everything else is the plain "ok" stub.
        handle {
            respond "ok" 200
        }
    }
}
