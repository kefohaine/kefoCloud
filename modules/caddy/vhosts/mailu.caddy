# mailu.{{DOMAIN}} — Mailu's own door (admin UI + the platform as served by
# mailu-front at 172.22.0.10:80). Deliberately separate from mail.{{DOMAIN}},
# which is the roundcube webmail door — the two names never overlap
# (operator request, 2026-10-19).
# TLS: DNS-01 via Cloudflare, with fallback ACME issuers when Let's Encrypt
# rate-limits (see vhosts/mail.{{DOMAIN}}.caddy for the issuer chain).

https://mailu.{{DOMAIN}} {
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    request_body {
        max_size 25m
    }
    header {
        import security_headers
    }
    reverse_proxy 172.22.0.10:80 {
        # strip Mailu front's own security headers so the site-level set
        # yields one value per field
		header_down -X-Frame-Options
		header_down -X-Content-Type-Options
		header_down -Referrer-Policy
    }
}