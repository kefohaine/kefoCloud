# kopia.{{DOMAIN}} — Kopia backup server (module: kopia).
#
# The web UI and its API (172.22.0.31:51515). Snapshots, policies and restores
# are driven from here.
#
# TAILNET-ONLY: the repository holds every module's data, so the name has no
# public A record — dnsmasq answers it for tailnet clients and every other
# source is refused before the proxy runs, the same model as vault/mailu.
# DNS-01 needs only the TXT record, so the certificate keeps issuing.
#
# TLS: fallback ACME issuer chain, DNS-01 via Cloudflare (same as every vhost).

https://kopia.{{DOMAIN}} {
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    @not_tailnet not remote_ip 100.64.0.0/10
    respond @not_tailnet 403
    header {
        import security_headers
    }
    request_body {
        max_size 0
    }
    reverse_proxy 172.22.0.31:51515 {
        header_up Host {host}
        # A restore streams whole directory trees; no proxy deadline.
        transport http {
            read_timeout 0
            write_timeout 0
        }
    }
}
