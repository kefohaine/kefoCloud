# cloud.{{DOMAIN}} — ownCloud Infinite Scale (oCIS).
#
# ownCloud is module `ocis` (modules/ocis/, container `ocis`), pinned at bridge
# 172.22.0.27 and serving port 9200. Caddy runs with network_mode: host, so it
# dials that bridge IP, not a container name. All paths are proxied unchanged:
# oCIS serves its own web UI at / and generates root-absolute URLs from its
# OCIS_URL.
#
# TLS: fallback ACME issuer chain, DNS-01 via Cloudflare (same as every vhost).

https://cloud.{{DOMAIN}} {
    # Two rate-limit zones, split by door — NOT the shared one-zone snippet.
    # A WebDAV client (macOS Finder, rclone, davfs2) legitimately issues
    # hundreds of PROPFINDs a minute over /remote.php/dav, and while this vhost
    # kept ONE per-host bucket the whole edge shared its 240 events: a sync
    # burned it, and the browser's next request for /config.json came back 429,
    # which the oCIS web front renders as "configuration manquante ou
    # incorrecte" (2026-11-14, 1532 x 429 in one session, 2 of them on
    # /config.json, same public IP as the sync). DAV gets its own wide zone so
    # the web UI can never be starved by a sync; the browser/API side keeps the
    # original budget.
    @dav path /remote.php/* /dav/*
    rate_limit @dav {
        zone cloud_dav_rl {
            key {remote_host}
            events 3000
            window 1m
        }
    }
    @web not path /remote.php/* /dav/*
    rate_limit @web {
        zone cloud_rl {
            key {remote_host}
            events 300
            window 1m
        }
    }
    # Access log for the fail2ban web-login jail (config/fail2ban): one file
    # per app so a jail bans on ITS login endpoint, not the whole edge.
    log {
        output file /var/log/caddy/ocis.log
    }
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    # Uploads are the app: no request-body ceiling at the edge.
    request_body {
        max_size 0
    }
    header {
        # NOT the shared security_headers snippet: oCIS already sends
        # X-Frame-Options, X-Content-Type-Options and its own CSP on every
        # response, and setting them again at the edge makes the browser see
        # each one TWICE (duplicate XFO is ignored by every current browser, so
        # the app's real frame policy still applies). Only the two headers oCIS
        # never sets are added here.
        Strict-Transport-Security "max-age=31536000"
        Referrer-Policy "strict-origin-when-cross-origin"
    }
    reverse_proxy 172.22.0.27:9200 {
        header_up Host {host}
    }
}
