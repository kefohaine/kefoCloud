# cloud.{{DOMAIN}} — Nextcloud. PHP-FPM at 172.22.0.5:9000 serves all
# .php requests; everything else is file_server from the static html
# root at /nextcloud. The @blocked matcher denies direct access to
# internal NC paths (data, config, lib, 3rdparty, templates, occ,
# db, updater) so a misconfigured upload can't expose them. The two
# /.well-known redirects let CardDAV/CalDAV auto-discovery work
# without exposing the long /remote.php/dav URL.
#
# TLS: Let's Encrypt DNS-01 via Cloudflare. Switched from the CF
# Origin CA wildcard cert because the wildcard served as a SNI
# fallback for other vhosts, blocking their per-vhost ACME
# automation policy from firing. Per-vhost ACME keeps each cert
# scoped to its own SNI.

https://cloud.{{DOMAIN}} {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    root * /nextcloud
    request_body {
        max_size 100m
    }
    @blocked path /data/* /config/* /lib/* /3rdparty/* /templates/* /occ /console.php /db/* /updater/*
    respond @blocked "not found" 404
    redir /.well-known/carddav /remote.php/dav 308
    redir /.well-known/caldav /remote.php/dav 308
{{IF CLIENT_PUSH}}
    # notify_push websocket/HTTP endpoint (container on 172.22.0.16). The app's
    # base_endpoint is https://cloud.{{DOMAIN}}/push, so the prefix is kept.
    handle /push/* {
        reverse_proxy 172.22.0.16:7867
    }
{{END}}
    php_fastcgi 172.22.0.5:9000 {
        root /var/www/html
        # notify_push (172.22.0.16) proxies its client requests through this
        # edge. Trusting its X-Forwarded-For keeps the real client address all
        # the way to Nextcloud — without it Caddy replaces the header with the
        # container IP and `occ notify_push:setup`'s trusted-proxy self-test
        # fails. Internal bridge peers only; public peers stay untrusted.
        trusted_proxies 172.22.0.16/32
        # strip NC's own security headers so the site-level header set below
        # yields exactly one value per field (Caddy appends, not replaces)
		header_down -X-Frame-Options
		header_down -X-Content-Type-Options
		header_down -Referrer-Policy
        dial_timeout 10s
        read_timeout 300s
        write_timeout 300s
    }
    encode zstd gzip
    header {
        import security_headers
    }
    file_server
}
