# talk.{{DOMAIN}} — Nextcloud Talk High Performance Backend (signaling) + TURN.
#
# /signaling* reverse-proxies the spreed-signaling websocket (container
# talk-hpb at 172.22.0.12:8080) — this is the wss:// endpoint Talk
# clients connect to. Everything else answers a plain ok by design: the
# vhost exists so clients have a public websocket URL and so Caddy issues
# the talk.{{DOMAIN}} LE cert (DNS-01) that talk-relay (coturn) reuses for
# TURNS on 5349.
#
# The talk.{{DOMAIN}} A record MUST stay DNS-only (grey cloud) at Cloudflare:
# TURN speaks UDP/TCP on 3478/5349 + relay 49160-49200, which the CF proxy
# cannot carry (HTTP(S) only). Same constraint as mail.{{DOMAIN}}.

https://talk.{{DOMAIN}} {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    header {
        import security_headers
    }

    # The signaling server serves its websocket + API at the root of its own
    # listener, so the /signaling prefix is stripped before proxying (the
    # official nginx template does the same with `proxy_pass .../`). Clients
    # still connect to wss://talk.{{DOMAIN}}/signaling.
    handle_path /signaling* {
        reverse_proxy 172.22.0.12:8080
    }

    handle {
        respond "ok" 200
    }
}
