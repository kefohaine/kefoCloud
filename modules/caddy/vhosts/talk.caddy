# talk.{{DOMAIN}} — Nextcloud Talk High Performance Backend (signaling) + TURN.
#
# /signaling* reverse-proxies the spreed-signaling websocket (container
# talk-hpb at 172.22.0.12:8080) — this is the wss:// endpoint Talk
# clients connect to. Everything else answers a plain ok by design: the
# vhost exists so clients have a public websocket URL and so Caddy issues
# the talk.{{DOMAIN}} LE cert (DNS-01) that talk-relay (coturn) reuses for
# TURNS on 5349.
#
# The talk.{{DOMAIN}} A record MUST stay DNS-only (grey cloud) at Cloudflare:
# TURN speaks UDP/TCP on 3478/5349 + relay 49160-49200, which the CF proxy
# cannot carry (HTTP(S) only). Same constraint as mail.{{DOMAIN}}.

https://talk.{{DOMAIN}} {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    header {
        import security_headers
    }

    # The Go signaling server serves the websocket at /spreed and the REST
    # API at /api/v1/*. Nextcloud registers the signaling URL as
    # https://talk.{{DOMAIN}}/signaling (see `occ talk:signaling:list`), and
    # Nextcloud Talk's REST calls use https://talk.{{DOMAIN}}/signaling/api/v1/*,
    # so Caddy rewrites both: /signaling -> /spreed and /signaling/api* -> /api*.

    # Websocket: exact /signaling -> /spreed on the signaling backend.
    # Non-regex literal-path rewrite: /signaling -> /spreed (Caddy's `rewrite`
    # preserves the websocket upgrade; the Go signaling server speaks plain
    # HTTP/1.1, and real clients use the H1.1 upgrade handshake which
    # `reverse_proxy` bridges).
    handle /signaling {
        rewrite /spreed
        reverse_proxy 172.22.0.12:8080
    }

    # REST API: /signaling/api* -> /api* on the backend (strip the /signaling
    # prefix). /signaling/api/v1/welcome must return the signaling Welcome JSON.
    handle /signaling/api/* {
        uri replace /signaling ""
        reverse_proxy 172.22.0.12:8080
    }

    handle {
        respond "ok" 200
    }
}
