# talk.{{DOMAIN}} — Nextcloud Talk High Performance Backend (signaling) + TURN.
#
# /signaling/spreed reverse-proxies the spreed-signaling websocket (container
# talk-hpb at 172.22.0.12:8080) — this is the wss:// endpoint Talk clients
# connect to (they append /spreed to the registered …/signaling URL), and
# /signaling/api/* proxies its REST API. A bare /signaling and everything
# else answers a plain ok by design: the vhost exists so clients have a
# public websocket URL and so Caddy issues the talk.{{DOMAIN}} LE cert
# (DNS-01) that talk-relay (coturn) reuses for TURNS on 5349.
#
# The talk.{{DOMAIN}} A record MUST stay DNS-only (grey cloud) at Cloudflare:
# TURN speaks UDP/TCP on 3478/5349 + relay 49160-49200, which the CF proxy
# cannot carry (HTTP(S) only). Same constraint as mail.{{DOMAIN}}.

https://talk.{{DOMAIN}} {
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    header {
        import security_headers
    }

    # The Go signaling server serves the websocket at /spreed and the REST
    # API at /api/v1/*. Nextcloud registers the signaling URL as
    # https://talk.{{DOMAIN}}/signaling (see `occ talk:signaling:list`), and
    # the Talk web client appends `/spreed` to that URL for the websocket
    # (`getWebSocketUrl()` in the spreed bundle), so the client connects to
    # /signaling/spreed and Caddy strips the prefix: /signaling/spreed ->
    # /spreed, /signaling/api* -> /api*.

    # Websocket: /signaling/spreed -> /spreed on the signaling backend.
    # Non-regex literal-path rewrite (Caddy's `rewrite` preserves the websocket
    # upgrade; the Go signaling server speaks plain HTTP/1.1, and real clients
    # use the H1.1 upgrade handshake which `reverse_proxy` bridges). Matching
    # the bare /signaling instead routes the client's real path to the ok stub.
    handle /signaling/spreed {
        rewrite /signaling/spreed /spreed
        reverse_proxy 172.22.0.12:8080
    }

    # REST API: /signaling/api* -> /api* on the backend (strip the /signaling
    # prefix). /signaling/api/v1/welcome must return the signaling Welcome JSON.
    handle /signaling/api/* {
        uri replace /signaling ""
        reverse_proxy 172.22.0.12:8080
    }

    handle {
        respond "ok" 200
    }
}
