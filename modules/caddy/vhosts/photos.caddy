# photos.{{DOMAIN}} — Immich photo library.
# Cloudflare mode: DNS-ONLY (grey cloud) — operator choice. Photo uploads and
# video streaming through the CF proxy hit its upload/body limits and the
# non-HTML ToS clauses, so the origin is exposed directly.
# TLS: Let's Encrypt DNS-01 via Cloudflare (grey cloud still gets a cert — DNS-01
# needs only the TXT record).

https://photos.{{DOMAIN}} {
    # Exposure (scripts/lib/exposure.sh): a tailnet-vpn door refuses every
    # non-tailnet source here, ahead of the limiter — a refused flood must not
    # spend the shared zone window; a cloudflare-dns door carries no gate.
    route {
        {{IF PHOTOS_EXPOSURE=tailnet-vpn}}@not_tailnet not remote_ip 100.64.0.0/10
        respond @not_tailnet 403{{END}}
        import ratelimit photos_rl
    }
    # Access log for the fail2ban web-login jail (config/fail2ban): one file
    # per app so a jail bans on ITS login endpoint, not the whole edge.
    log {
        output file /var/log/caddy/immich.log
    }
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    # Uploads: Immich streams originals of any size; the edge must not cap the
    # body at Caddy's default.
    request_body {
        max_size 0
    }
    header {
        import security_headers
    }
    reverse_proxy 172.22.0.23:2283 {
        header_down -X-Frame-Options
        header_down -X-Content-Type-Options
        header_down -Referrer-Policy
        header_down -Strict-Transport-Security
    }
}
