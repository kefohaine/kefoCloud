# www.{{DOMAIN}} — static pages: the welcome pages and the public download drop
# folder.
#   /          serves index.html from $DATA_DIR/pages/www — a zero-second
#              redirect to /welcome. The skeleton ships no public pages: the
#              installer seeds one placeholder index.html and the operator owns
#              the rest of that directory.
#   (root)     every route below reads `root * /srv/pages/www` — the caddy
#              container mounts $DATA_DIR/pages at /srv/pages read-only.
#   /welcome   the welcome page (welcome.html) — everything {{DOMAIN}} runs,
#              presented as the live demo of {{GITHUB_USER}}/{{REPO_NAME}}.
#   /welcome-5 /welcome-6 /welcome-7 /welcome-9 — the kept alternate
#              tellings (neon / journal / field manual / poster).
#   /download* Caddy file_server browse over homelab/download (mounted at
#              /download:ro in the caddy container — drop files here).
#   everything else — plain "ok" stub.
# TLS: Let's Encrypt DNS-01 via Cloudflare (see vhosts/cloud.{{DOMAIN}}.caddy).

# The bare domain is the address people type: it must never be a dead end.
# There is one canonical homepage (www.{{DOMAIN}}), so the apex answers with a
# permanent redirect rather than a second copy of the site.
https://{{DOMAIN}} {
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    header {
        import security_headers
    }
    redir https://www.{{DOMAIN}}{uri} permanent
}

https://www.{{DOMAIN}} {
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    header {
        import security_headers
    }
    handle_path /download {
        root * /download
        file_server browse
    }
    handle_path /download/* {
        root * /download
        file_server browse
    }
    # The welcome page — one self-contained HTML file. Matched with or
    # without a trailing slash; anything else keeps falling through to the
    # ok stub.
    @welcome path /welcome /welcome/
    handle @welcome {
        root * /srv/pages/www
        rewrite /welcome.html
        file_server
    }
    # The welcome family: the original `/welcome` plus the kept alternate
    # tellings — /welcome-5 (neon), /welcome-6 (journal), /welcome-7 (field
    # manual), /welcome-9 (poster). Removed designs were dropped 2026-09-13
    # by operator choice; numbers are intentionally non-contiguous.
    # The @wN matcher + handle pairs are also what the targets catalogue
    # generator reads, so the pages auto-appear in the tail door list.
    @w5 path /welcome-5 /welcome-5/
    handle @w5 {
        root * /srv/pages/www
        rewrite /welcome-5.html
        file_server
    }
    @w6 path /welcome-6 /welcome-6/
    handle @w6 {
        root * /srv/pages/www
        rewrite /welcome-6.html
        file_server
    }
    @w7 path /welcome-7 /welcome-7/
    handle @w7 {
        root * /srv/pages/www
        rewrite /welcome-7.html
        file_server
    }
    @w9 path /welcome-9 /welcome-9/
    handle @w9 {
        root * /srv/pages/www
        rewrite /welcome-9.html
        file_server
    }
    # /docs — the Zensical build (scripts/modules/docs-build.sh renders the
    # repo's docs/ tree into $DATA_DIR/pages/www/docs). handle_path strips the
    # prefix so the site's relative asset links resolve under /docs/.
    @docs path /docs
    redir @docs /docs/ 308
    handle_path /docs/* {
        root * /srv/pages/www/docs
        file_server
    }
    # /home — the Homer dashboard. Homer serves its assets with RELATIVE urls
    # ("assets/...", "./resources/..."), so strip the prefix and let the app
    # answer at /: /home/ -> /, /home/assets/x -> /assets/x.
    handle /home* {
        uri strip_prefix /home
        reverse_proxy 172.22.0.7:8080
    }
    # Homepage: the index.html placeholder (meta-redirects to /welcome).
    @index path /
    handle @index {
        root * /srv/pages/www
        file_server
    }
    handle {
        respond "ok" 200
    }
}
