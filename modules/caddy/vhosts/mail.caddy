# mail.{{DOMAIN}} — Roundcube webmail (Mailu platform).
# TLS: Let's Encrypt DNS-01 via Cloudflare (same pattern as every vhost).
# Mailu front reuses this cert for SMTP/IMAP TLS. The installer copies the
# issued mail.{{DOMAIN}} pair from caddy_data to mailserver/certs (mounted at
# /certs), so renewals are shared and front restarts on renewal.

https://mail.{{DOMAIN}} {
    tls {
        dns cloudflare {env.CF_API_TOKEN}
    }
    import compress
    request_body {
        max_size 25m
    }
    header {
        import security_headers
    }
    reverse_proxy 172.22.0.10:80 {
        # strip roundcube's own security headers so the site-level set yields one value
		header_down -X-Frame-Options
		header_down -X-Content-Type-Options
		header_down -Referrer-Policy
    }
}
