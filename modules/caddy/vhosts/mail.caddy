# mail.{{DOMAIN}} — Roundcube webmail (container `roundcube` at 172.22.0.10:80)
# and the name the mail platform is reached by from outside: mailu-front
# publishes 25/465/587/993 on the host and serves the mail.{{DOMAIN}} cert, so
# this name MUST stay in public DNS (DNS-only — the CF proxy carries no SMTP/
# IMAP) for inbound mail, client IMAP/SMTP and the MX/SPF that point at it.
#
# Roundcube is a web client only: it reaches the platform over STARTTLS at
# tls://mail.{{DOMAIN}}:143/:587 (modules/mailserver/roundcube-tls.inc.php),
# i.e. mailu-front, whose cert is this same mail.{{DOMAIN}} pair. The Mailu
# platform/admin UI has its own tailnet-only name (./admin.mail.caddy).
# TLS: fallback ACME issuer chain, DNS-01 via Cloudflare (same as every vhost).

https://mail.{{DOMAIN}} {
    import ratelimit mail_rl
    # Access log for the fail2ban web-login jail (config/fail2ban): one file
    # per app so a jail bans on ITS login endpoint, not the whole edge.
    log {
        output file /var/log/caddy/roundcube.log
    }
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    request_body {
        max_size 25m
    }
    header {
        import security_headers
    }
    reverse_proxy 172.22.0.10:80 {
        # strip roundcube's own security headers so the site-level set yields one value
		header_down -X-Frame-Options
		header_down -X-Content-Type-Options
		header_down -Referrer-Policy
    }
}
