# mail.{{DOMAIN}} — Mailu's platform door (admin UI + the platform as served by
# mailu-front at 172.22.0.9:80). This is also the name SMTP/IMAP present: the
# installer copies the issued mail.{{DOMAIN}} pair from caddy_data to
# mailserver/certs (mounted at /certs on mailu-front, which terminates the
# 25/465/587/993 listeners), so the web door and the protocol cert are the same
# name, and mailu-front's SNI/cert check matches its own hostname.
# The webmail door is cube.{{DOMAIN}} (Roundcube at 172.22.0.10).
# TLS: fallback ACME issuer chain, DNS-01 via Cloudflare (same as every vhost).

https://mail.{{DOMAIN}} {
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    request_body {
        max_size 25m
    }
    header {
        import security_headers
    }
    reverse_proxy 172.22.0.9:80 {
        # strip Mailu front's own security headers so the site-level set
        # yields one value per field
		header_down -X-Frame-Options
		header_down -X-Content-Type-Options
		header_down -Referrer-Policy
		header_down -Strict-Transport-Security
    }
}
