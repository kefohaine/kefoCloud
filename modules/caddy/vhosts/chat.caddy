# chat.{{DOMAIN}} — Element, the Matrix web client (module: chat).
#
# Static React app served by the container's own nginx on 172.22.0.29:80. All
# routing, branding and the homeserver URL come from the runtime config at
# /app/config.json ($DATA_DIR/matrix/element/config.json, generated by
# `make matrix-gen`): Element talks to https://matrix.{{DOMAIN}} directly, so
# this vhost proxies nothing but the app itself.
#
# Public and proxied at Cloudflare: a browser client needs nothing but HTTPS.
# TLS: fallback ACME issuer chain, DNS-01 via Cloudflare (same as every vhost).

https://chat.{{DOMAIN}} {
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    header {
        import security_headers
    }
    reverse_proxy 172.22.0.29:80 {
        header_up Host {host}
        # Element ships its own copy of these; strip them so the site-level
        # set above yields one value per field (Caddy appends, not replaces).
        header_down -X-Frame-Options
        header_down -X-Content-Type-Options
        header_down -Referrer-Policy
    }
}
