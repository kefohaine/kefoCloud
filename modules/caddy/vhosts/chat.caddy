# chat.{{DOMAIN}} — reserved name, deliberately EMPTY.
#
# The chat application that used to own this hostname is gone from the repo, so
# this vhost proxies to NOTHING: it answers an empty 200 body and exists only so
# the name stays reachable and keeps its own certificate while it waits for its
# next app. Never point it at another vhost's service — one name, one app.
# TLS: Let's Encrypt DNS-01 via Cloudflare (see vhosts/cloud.{{DOMAIN}}.caddy).

https://chat.{{DOMAIN}} {
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    header {
        import security_headers
    }
    respond "" 200
}
