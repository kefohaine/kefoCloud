# chat.{{DOMAIN}} — Rocket.Chat.
#
# Public door (Cloudflare proxied): a chat server is useless behind a tailnet
# gate. Rocket.Chat serves its own websocket on /websocket, which Caddy's
# reverse_proxy upgrades transparently — no separate route is needed.
# TLS: Let's Encrypt DNS-01 via Cloudflare (see vhosts/cloud.{{DOMAIN}}.caddy).

https://chat.{{DOMAIN}} {
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    request_body {
        # File uploads and avatars go through the edge; Rocket.Chat's own
        # default limit is 100m, keep the edge from being the smaller one.
        max_size 100m
    }
    header {
        import security_headers
    }
    reverse_proxy 172.22.0.28:3000 {
        # Rocket.Chat sets X-Frame-Options / X-Content-Type-Options itself; both
        # would then be sent twice and smoke's exactly-one check fails.
        header_down -X-Frame-Options
        header_down -X-Content-Type-Options
        # Long-lived websocket + slow admin pages.
        transport http {
            read_timeout 300s
            write_timeout 300s
        }
    }
}
