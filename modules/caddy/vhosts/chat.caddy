# chat.{{DOMAIN}} + its groups/share names — Snikket XMPP (module: xmpp).
#
# One name, one app: these three hostnames are Snikket's own (the server's
# group-chat and file-share components are named groups./share. by the server
# itself, from SNIKKET_DOMAIN=chat.{{DOMAIN}}). No other vhost may proxy to
# Snikket's ports, and this vhost may not proxy to anything else.
#
# HTTP is proxied to Snikket's own nginx (127.0.0.1:5080) so its certbot
# HTTP-01 challenges answer; HTTPS terminates at Caddy and re-encrypts to
# Snikket's self-managed cert on 127.0.0.1:5443. Snikket is host-networked
# (XMPP 5222/5269, TURN, proxy65 cannot ride an L7 proxy), so the upstream is
# the loopback, not a bridge address.
#
# Web clients (and OMEMO-capable browser clients) need:
#   * wss:// on /xmpp-websocket (RFC 7395) and BOSH on /http-bind — both are
#     proxied here and upgraded transparently by reverse_proxy, with a long
#     read/write timeout because the socket stays open;
#   * cross-origin answers for those endpoints plus /upload (XEP-0363): the
#     browser preflights OPTIONS and then PUTs to the slot URL, which lands on
#     /upload/* — prosody answers BOSH/WS preflights itself, the edge covers
#     the upload component;
#   * a body limit above the server's own 100MB + 16 bytes file-share ceiling.
# TLS: fallback ACME issuer chain, DNS-01 via Cloudflare (same as every vhost).

http://chat.{{DOMAIN}}, http://groups.chat.{{DOMAIN}}, http://share.chat.{{DOMAIN}} {
	reverse_proxy 127.0.0.1:5080 {
		header_up Host {host}
	}
}

https://chat.{{DOMAIN}}, https://groups.chat.{{DOMAIN}}, https://share.chat.{{DOMAIN}} {
	tls {
		# Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
		# ZeroSSL — free providers tried in order, so a per-issuer rate limit
		# (5 orders/name/week on LE) never leaves a vhost without a cert.
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			email admin@{{DOMAIN}}
			dns cloudflare {env.CF_API_TOKEN}
		}
		issuer acme https://api.buypass.com/acme/directory {
			email admin@{{DOMAIN}}
			dns cloudflare {env.CF_API_TOKEN}
		}
		issuer acme https://acme.zerossl.com/v2/DV90 {
			email admin@{{DOMAIN}}
			dns cloudflare {env.CF_API_TOKEN}
		}
	}
	import compress
	header {
		import security_headers
	}
	request_body {
		max_size 104857616
	}
	# Upload slots only: the browser PUTs the (OMEMO-encrypted) blob to this
	# origin from another page, so the answer must carry the allow headers and
	# a preflight must not reach prosody.
	@upload path /upload /upload/*
	header @upload {
		Access-Control-Allow-Origin "*"
		Access-Control-Allow-Methods "GET, PUT, POST, OPTIONS"
		Access-Control-Allow-Headers "*"
		Access-Control-Max-Age "86400"
	}
	@upload_preflight {
		method OPTIONS
		path /upload /upload/*
	}
	respond @upload_preflight 204
	reverse_proxy https://127.0.0.1:5443 {
		header_up Host {host}
		header_up X-Forwarded-Proto https
		# Long-lived websocket + slow uploads; Snikket's own nginx uses 900s.
		transport http {
			tls_server_name {host}
			tls_insecure_skip_verify
			read_timeout 900s
			write_timeout 900s
		}
	}
}
