# admin.mail.{{DOMAIN}} — Mailu's platform door (admin UI at /admin + the
# platform as served by mailu-front at 172.22.0.9:80). Its default exposure is
# `tailnet-vpn`: no public A record — tailnet clients resolve the name through
# the machine dnsmasq (config/dnsmasq/10-tailnet.conf) and every other source is
# refused before the proxy runs (@not_tailnet). `make vhost-exposure` may publish
# it instead; DNS-01 needs only the TXT record, so the certificate keeps issuing.
#
# The FRONT keeps the name mail.{{DOMAIN}} (compose HOSTNAMES): that is the name
# SMTP/IMAP present and the one its /certs pair is issued for, and it is the
# public webmail door too (./mail.caddy).
# TLS: fallback ACME issuer chain, DNS-01 via Cloudflare (same as every vhost).

https://admin.mail.{{DOMAIN}} {
    # Access log for the fail2ban platform-door jail (config/fail2ban): one file
    # per app so a jail bans on ITS login endpoint, not the whole edge.
    log {
        output file /var/log/caddy/admin.mail.log
    }
    tls {
        # Fallback issuer chain: Let's Encrypt first, then Buypass Go SSL and
        # ZeroSSL — free providers tried in order, so a per-issuer rate limit
        # (5 orders/name/week on LE) never leaves a vhost without a cert.
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://api.buypass.com/acme/directory {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
        issuer acme https://acme.zerossl.com/v2/DV90 {
            email admin@{{DOMAIN}}
            dns cloudflare {env.CF_API_TOKEN}
        }
    }
    import compress
    request_body {
        max_size 25m
    }
    header {
        import security_headers
    }
    # Exposure (scripts/lib/exposure.sh): a tailnet-vpn door refuses every
    # source outside 100.64.0.0/10 here, before the proxy (the name is not in
    # public DNS either), and the gate sits ahead of the limiter so a refused
    # flood cannot consume the shared zone window. A cloudflare-dns door keeps
    # the limiter and the proxy, and drops the gate.
    route {
        {{IF ADMIN_MAIL_EXPOSURE=tailnet-vpn}}@not_tailnet not remote_ip 100.64.0.0/10
        respond @not_tailnet 403{{END}}
        import ratelimit admin_mail_rl
        reverse_proxy 172.22.0.9:80 {
            # strip Mailu front's own security headers so the site-level set
            # yields one value per field
            header_down -X-Frame-Options
            header_down -X-Content-Type-Options
            header_down -Referrer-Policy
            header_down -Strict-Transport-Security
        }
    }
}
